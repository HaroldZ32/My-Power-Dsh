{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/self-fix-tests/**/*.ts",
    "scripts/**/*.ts",
    "skills/*/scripts/**/*.ts",
    "docker/**/*.ts",
    "tests/**/*.ts",
    "templates/**/*.ts",
    "extensions/**/*.ts"
  ],
  // NO TREE IS EXCLUDED FROM THE TYPE PROGRAM ANY MORE.
  //
  // The two entries that used to live here pointed at the ADOPTED `packages/mpd-agent-teams-plugin`
  // (its suite was declared out of the program because ~380 adopted test bodies were written against
  // the `any` surface an untyped import gives). The de-vendor wave DELETED that package, so the
  // exclusion has no subject and keeping it would be a justification for a tree that does not exist.
  //
  // The relocated home needs NO entry either, and here is the reason rather than a guess: every file
  // under `packages/mpd-schemastery/{lib,harness}` carries a first-line `@ts-nocheck`, which
  // suppresses diagnostics INSIDE the file while leaving its inferred types visible to importers.
  // That is exactly the contract the four shipped plugins rely on — they import the validator as a
  // package directory and take their types from `lib/types/index.d.ts` through `exports.types`, which
  // is where the global `Schemastery<T>` interface lives. An `exclude` entry could only hide those
  // files from the declaration-coverage walk without removing a single diagnostic.
  "exclude": []
}
