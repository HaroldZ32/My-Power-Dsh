{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/self-fix-tests/**/*.ts",
    "scripts/**/*.ts",
    "skills/*/scripts/**/*.ts",
    "docker/**/*.ts",
    "tests/**/*.ts",
    "templates/**/*.ts",
    "extensions/**/*.ts"
  ]
}
