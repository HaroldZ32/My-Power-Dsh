{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": [
        "./_deps/cordis/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-agent": [
        "./_deps/dsh-agent/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-commands": [
        "./_deps/dsh-commands/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-llm": [
        "./_deps/dsh-llm/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-scope": [
        "./_deps/dsh-scope/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-session": [
        "./_deps/dsh-session/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-session/types": [
        "./_deps/dsh-session/lib/types/types.d.ts"
      ],
      "@deepseek-ai/dsh-subagent": [
        "./_deps/dsh-subagent/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-system-prompt": [
        "./_deps/dsh-system-prompt/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-timeout": [
        "./_deps/dsh-timeout/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-tools": [
        "./_deps/dsh-tools/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-workspace": [
        "./_deps/dsh-workspace/lib/types/index.d.ts"
      ],
      "@deepseek-ai/schemastery": [
        "./_deps/schemastery/lib/types/index.d.ts"
      ],
      "@standard-schema/spec": [
        "./_deps/standard-schema/dist/index.d.ts"
      ],
      "zod": [
        "./_deps/zod/index.d.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/client",
    "dist"
  ]
}
