{
  "name": "@mpd-dsh/agent-teams",
  "version": "0.1.14",
  "private": true,
  "description": "Adopted @nanmicoder/dsh-agent-teams (v0.1.14, MIT) as a first-class main-code package: multi-agent team collaboration (captain, members, tasks with dependencies, messaging) + web activity panel. Server runtime closure vendored under _deps/ (see scripts/vendor-agent-teams.mjs); client bundle loaded by the web app via the mpd bundle's ./client export.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "_deps",
    "assets/agent-teams",
    "assets/readme",
    "assets/ui.png",
    "README.md",
    "README_ZH.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": {
    "name": "程序员阿江 (Relakkes)",
    "email": "relakkes@gmail.com",
    "url": "https://github.com/NanmiCoder"
  },
  "homepage": "https://github.com/NanmiCoder/dsh-agent-teams#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanmiCoder/dsh-agent-teams.git"
  },
  "bugs": {
    "url": "https://github.com/NanmiCoder/dsh-agent-teams/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-teams",
    "multi-agent",
    "subagent",
    "ai-agent",
    "llm"
  ]
}
