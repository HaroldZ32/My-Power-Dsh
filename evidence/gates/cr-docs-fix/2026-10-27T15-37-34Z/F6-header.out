=== wrapper cleanup branch ===
62:printf '[shoot-team-dag] measuring the framing (docker/ui/measure-shots.py web)\n'
63-python3 "$HERE/measure-shots.py" web --facts "$FACTS" --png "$OUT" --json "${FACTS%.json}.measure.json" --label "$(basename "$OUT")"
64-measure_status=$?
65-if [ "$measure_status" -ne 0 ]; then
66-  rm -f "$OUT"
67-  printf '[shoot-team-dag] the measurement REJECTED %s (exit %s) — the PNG was deleted\n' "$(basename "$OUT")" "$measure_status" >&2
68-  exit "$measure_status"
