      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "optionalDependencies": {
    "@ast-grep/cli": "0.45.2",
    "@colbymchenry/codegraph": "1.5.0",
    "@code-yeongyu/comment-checker": "0.8.0"
