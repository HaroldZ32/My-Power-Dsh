   "kept": true,
   "before": {
    "status": "failed",
    "assignee": "Architect",
    "attempt": 1,
    "output": "EARNED-DELIVERABLE"
   },
   "after": {
    "status": "failed",
    "assignee": "Architect",
    "attempt": 1,
    "output": "EARNED-DELIVERABLE"
   },
   "threw": "task t1 is failed: the attempt rotation is REFUSED for terminal work — a terminal task is never re-armed (the record was"
