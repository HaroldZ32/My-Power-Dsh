{
 "instrument": "t33 reviewer driver (real lib/state.js)",
 "module": "packages/mpd-agent-teams-plugin/lib/state.js",
 "probes": [
  {
   "id": "drop-pending-first-dispatch",
   "what": "a PENDING task's first dispatch (new generation)",
   "expect": "DROP",
   "kept": false,
   "before": {
    "status": "pending",
    "assignee": "Architect",
    "attempt": 1,
    "attemptId": "att-1",
    "output": "LEFTOVER"
   },
   "after": {
    "status": "claimed",
    "assignee": "Architect",
    "attempt": 2,
    "attemptId": "61428121-bc7b-47a1-9230-bd0593c0d406",
    "reassigning": false
   },
   "returned": "61428121-bc7b-47a1-9230-bd0593c0d406"
  },
  {
   "id": "drop-handover-compose",
   "what": "a compose naming a DIFFERENT assignee (handover)",
   "expect": "DROP",
   "kept": false,
   "before": {
    "status": "in_progress",
    "assignee": "Architect",
    "attempt": 1,
    "attemptId": "att-1",
    "output": "EARNED-DELIVERABLE"
   },
   "after": {
    "status": "claimed",
    "assignee": "Beta",
    "attempt": 1,
    "attemptId": "ad9968a0-a86b-4b20-8681-dbfd71d02973",
    "reassigning": false
   },
   "returned": "ad9968a0-a86b-4b20-8681-dbfd71d02973"
