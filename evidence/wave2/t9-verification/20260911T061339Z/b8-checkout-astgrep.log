  "stdout": "{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"tools\":{\"listChanged\":false}},\"serverInfo\":{\"name\":\"ast_grep\",\"version\":\"0.1.0\"},\"protocolVersion\":\"2024-11-05\"}}\n{\"jsonrpc\":\"2.0\",\"id\":2,\"result\":{\"tools\":[{\"name\":\"search\",\"description\":\"Search code structurally with ast-grep. The pattern is code, not regex, and must parse as one AST node in the required language; use narrow paths. `$NAME` and `$_` match one whole node, while `$$$NAME` and `$$$` match zero-or-more nodes. Names are uppercase, `$$NAME` is invalid, partial-token captures do not work, and a repeated metavariable must match identical code. Wrap non-standalone syntax and use `selector` when needed. Parse warnings mean the query failed, not that the code is absent.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\",\"minLength\":1,\"description\":\"ast-grep pattern — code, not regex. Max 16 KiB (16384 BYTES, UTF-8) — the limit counts bytes, not characters.\"},\"language\":{\"type\":\"string\",\"enum\":[\"bash\",\"c\",\"cpp\",\"csharp\",\"css\",\"elixir\",\"go\",\"haskell\",\"html\",\"java\",\"javascript\",\"json\",\"kotlin\",\"lua\",\"nix\",\"php\",\"python\",\"ruby\",\"rust\",\"scala\",\"solidity\",\"swift\",\"typescript\",\"tsx\",\"yaml\"],\"description\":\"Language the pattern must parse in.\"},\"paths\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":64,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"description\":\"Files or directories to search. Required — there is no implicit '.' default.\"},\"workdir\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096,\"description\":\"Working directory for the sg process. Defaults to the server's cwd.\"},\"globs\":{\"type\":\"array\",\"maxItems\":32,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1024},\"description\":\"Optional include/exclude globs passed through to ast-grep.\"},\"selector\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":128,\"description\":\"Optional sub-node selector.\"},\"strictness\":{\"type\":\"string\",\"enum\":[\"cst\",\"smart\",\"ast\",\"relaxed\",\"signature\"],\"description\":\"Match strictness (default smart).\"},\"maxMatches\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":500,\"description\":\"Maximum matches to return (default 50).\"},\"timeoutMs\":{\"type\":\"integer\",\"minimum\":1000,\"maximum\":300000,\"description\":\"Whole-call timeout budget in milliseconds (default 300000).\"},\"includeHidden\":{\"type\":\"boolean\",\"description\":\"Include hidden files (--no-ignore hidden).\"},\"followSymlinks\":{\"type\":\"boolean\",\"description\":\"Follow symlinks (--follow).\"},\"force\":{\"type\":\"boolean\",\"description\":\"Bypass non-fatal pattern hint rejections.\"}},\"required\":[\"pattern\",\"language\",\"paths\"],\"additionalProperties\":false}},{\"name\":\"rewrite\",\"description\":\"Preview or apply an AST-aware rewrite. The pattern follows the same metavariable rules as `search`; the replacement may only reference metavariables captured by the pattern, and an empty replacement deletes the match. Dry-run is the default. Apply uses a JSON preview followed by a separate `--update-all` process because `sg` cannot safely combine JSON output and mutation. Truncated previews are never applied, and rewrite idempotency is not guaranteed.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"pattern\":{\"type\":\"string\",\"minLength\":1,\"description\":\"ast-grep pattern — code, not regex. Max 16 KiB (16384 BYTES, UTF-8) — the limit counts bytes, not characters.\"},\"rewrite\":{\"type\":\"string\",\"description\":\"Replacement code; empty deletes the match. Max 64 KiB (65536 BYTES, UTF-8) — the limit counts bytes, not characters.\"},\"language\":{\"type\":\"string\",\"enum\":[\"bash\",\"c\",\"cpp\",\"csharp\",\"css\",\"elixir\",\"go\",\"haskell\",\"html\",\"java\",\"javascript\",\"json\",\"kotlin\",\"lua\",\"nix\",\"php\",\"python\",\"ruby\",\"rust\",\"scala\",\"solidity\",\"swift\",\"typescript\",\"tsx\",\"yaml\"],\"description\":\"Language the pattern must parse in.\"},\"paths\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":64,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"description\":\"Files or directories to search. Required — there is no implicit '.' default.\"},\"workdir\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096,\"description\":\"Working directory for the sg process. Defaults to the server's cwd.\"},\"globs\":{\"type\":\"array\",\"maxItems\":32,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1024},\"description\":\"Optional include/exclude globs passed through to ast-grep.\"},\"selector\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":128,\"description\":\"Optional sub-node selector.\"},\"strictness\":{\"type\":\"string\",\"enum\":[\"cst\",\"smart\",\"ast\",\"relaxed\",\"signature\"],\"description\":\"Match strictness (default smart).\"},\"apply\":{\"type\":\"boolean\",\"description\":\"Write the rewrite to disk. Default false (dry run).\"},\"maxMatches\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":500,\"description\":\"Maximum matches to return (default 50).\"},\"timeoutMs\":{\"type\":\"integer\",\"minimum\":1000,\"maximum\":300000,\"description\":\"Whole-call timeout budget in milliseconds (default 300000).\"},\"includeHidden\":{\"type\":\"boolean\",\"description\":\"Include hidden files (--no-ignore hidden).\"},\"followSymlinks\":{\"type\":\"boolean\",\"description\":\"Follow symlinks (--follow).\"},\"force\":{\"type\":\"boolean\",\"description\":\"Bypass non-fatal pattern hint rejections.\"}},\"required\":[\"pattern\",\"rewrite\",\"language\",\"paths\"],\"additionalProperties\":false}},{\"name\":\"scan\",\"description\":\"Scan files with exactly one explicit ast-grep YAML rule source. Provide either ruleFile or inlineRules; ambient sgconfig.yml discovery is never used. Dry-run is the default. Apply uses a bounded JSON preview followed by a separate plain --update-all pass, and truncated previews are never applied.\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"ruleFile\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096,\"description\":\"Path to a YAML rule file. Mutually exclusive with inlineRules.\"},\"inlineRules\":{\"type\":\"string\",\"minLength\":1,\"description\":\"Inline YAML rule text. Mutually exclusive with ruleFile. Max 64 KiB (65536 BYTES, UTF-8) — the limit counts bytes, not characters.\"},\"paths\":{\"type\":\"array\",\"minItems\":1,\"maxItems\":64,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096},\"description\":\"Files or directories to search. Required — there is no implicit '.' default.\"},\"workdir\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":4096,\"description\":\"Working directory for the sg process. Defaults to the server's cwd.\"},\"globs\":{\"type\":\"array\",\"maxItems\":32,\"items\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":1024},\"description\":\"Optional include/exclude globs passed through to ast-grep.\"},\"maxMatches\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":500,\"description\":\"Maximum matches to return (default 50).\"},\"timeoutMs\":{\"type\":\"integer\",\"minimum\":1000,\"maximum\":300000,\"description\":\"Whole-call timeout budget in milliseconds (default 300000).\"},\"includeHidden\":{\"type\":\"boolean\",\"description\":\"Include hidden files (--no-ignore hidden).\"},\"followSymlinks\":{\"type\":\"boolean\",\"description\":\"Follow symlinks (--follow).\"},\"includeMetadata\":{\"type\":\"boolean\",\"description\":\"Include rule metadata in each match.\"},\"apply\":{\"type\":\"boolean\",\"description\":\"Write rule fixes to disk. Default false (dry run).\"}},\"required\":[\"paths\"],\"additionalProperties\":false}}]}}\n{\"jsonrpc\":\"2.0\",\"id\":10,\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"{\\\"schemaVersion\\\":1,\\\"ok\\\":true,\\\"kind\\\":\\\"search\\\",\\\"workdir\\\":\\\"/tmp/t9-b8-mw2Mrh