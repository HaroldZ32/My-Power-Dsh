## 2) `mcp__ast_grep__scan`（扫描 `tests/mcp-fixtures/sample.c`）

参数：`paths=["tests/mcp-fixtures/sample.c"]`、`workdir=.../omo-dsh`、`inlineRules`（`language: c`，规则 `kind: function_definition`）。返回的关键输出：

```json
{"schemaVersion":1,"ok":true,"kind":"scan","workdir":"/home/haroldzhao/dshProj/oh-my-openagent/.omo/port/omo-dsh","applied":false,"matches":[{"path":"tests/mcp-fixtures/sample.c","language":"c","text":"int main(void) { return 0; }","range":{"start":{"line":1,"column":0,"byteOffset":0},"end":{"line":1,"column":28,"byteOffset":28}},"metavariables":{"single":{},"multi":{}},"replacement":"","rule":{"ruleId":"sample-scan","severity":"hint","message":"","labels":[{"text":"int main(void) { return 0; }","range":{"byteOffset":{"start":0,"end":28},"start":{"line":0,"column":0},"end":{"line":0,"column":28}},"style":"primary"}]}}],"counts":{"plannedMatches":1,"plannedFiles":1},"truncation":{"truncated":false,"reason":null,"maxMatches":50,"maxPayloadBytes":4194304,"salvagedRecords":0},"application":{"requested":false,"performed":false,"countsArePreviewBased":true,"secondPassExitCode":null},"warnings":[],"durationMs":6}
