      "payload_halted": true,
      "payload_pause": "(absent)"
    },
    {
      "label": "3 held internally (hold id + reason set)",
      "pause_line": [
        "Pause: agent-teams halt not active · team watchdog hold: not read on this surface — run session-watchdog-status (released only by its own session-watchdog-resume)"
      ],
      "payload_halted": false,
      "payload_pause": "(absent)"
    },
    {
      "label": "4 watchdog service absent (fail-open read)",
      "pause_line": [
        "Pause: agent-teams halt not active · team watchdog hold: not read on this surface — run session-watchdog-status (released only by its own session-watchdog-resume)"
      ],
      "payload_halted": false,
