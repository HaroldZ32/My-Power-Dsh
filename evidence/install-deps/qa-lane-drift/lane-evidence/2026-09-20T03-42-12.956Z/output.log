name === '@deepseek-ai/dsh-host-webserver' && e.options.disabled !== true); const hasWebLayer = bundles.indexOf('@deepseek-ai/dsh-web-app') >= 0; if (!hasWebEntry && !hasWebLayer) { say('DISABLED', 'no web plane in this composition'); return true } say('ENABLED', 'web plane present and no other layer mounts dsh-better-sidebar'); return false } catch (e) { try { console.warn('[mpd-better-sidebar] mount guard: DISABLED - guard threw ' + String(e && e.message ? e.message : e)) } catch (e2) {} return true } })()"
