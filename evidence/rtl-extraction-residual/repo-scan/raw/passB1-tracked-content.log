evidence/agent-teams/scheduler-wakeup-fix/2026-09-10T10-16-23Z/captain-session-f333e946.jsonl:421:{"type":"tool/result","seq":9707,"time":1789026768342,"data":{"turn":1,"step":6,"message":{"source":{"kind":"tool","callId":"call_01_M1qGM7M1JtI7MBSaE9y13786"},"content":[{"type":"tool-result","toolCallId":"call_01_M1qGM7M1JtI7MBSaE9y13786","content":[{"type":"text","text":"=== READONLY deny in roles plugin ===\npackages/mpd-roles-plugin/src/index.ts:23:export const READONLY_DENY = [\npackages/mpd-roles-plugin/src/index.ts:26:  \"str_replace_editor\",\npackages/mpd-roles-plugin/src/index.ts:27:  \"apply_patch\",\npackages/mpd-roles-plugin/src/index.ts:123:        ...(spec.readonly ? { toolFilter: { deny: READONLY_DENY } } : {})\npackages/mpd-roles-plugin/src/roles.data.ts:15:  /** Read-only roles spawn with a write-tool deny filter; workers spawn unrestricted. */\npackages/mpd-workmate-plugin/src/index.ts:30:const READONLY_DENY = [\"write\", \"edit\", \"str_replace_editor\", \"apply_patch\", \"mpd_hashline_edit\"]\npackages/mpd-workmate-plugin/src/index.ts:309:        ...(meta.readonly ? { toolFilter: { deny: READONLY_DENY } } : {})\n\n=== workmate test readonly coverage ===\n  expect(m2.suggestion).toContain(\"NEW workmate\")\n\n  // service exposes list/get/read\n  expect(provided.mpdWorkmate.list().length).toBe(2)\n  expect(provided.mpdWorkmate.get(\"alice\").note).toContain(\"Deep Worker\")\n  expect(provided.mpdWorkmate.read(\"alice\").memory).toContain(\"implement verilog counter\")\n  expect(provided.mpdWorkmate.get(\"missing\")).toBeNull()\n})\n\ntest(\"spawn carries persona+memory+note, reflect instruction, readonly deny, own route\", async () => {\n  sandboxHome()\n  const { byName, spawned, exec } = makePlugin()\n  await byName(\"mpd_workmate_init\").execute({ base: \"hephaestus\", name: \"alice\" }, exec)\n  await byName(\"mpd_workmate_reflect\").execute({ name: \"alice\", task: \"verify counter\", outcome: \"verified\" }, exec)\n  const out = await byName(\"mpd_workmate_spawn\").execute({ name: \"alice\", task: \"add a reset\", context: \"module is cnt8\" }, exec)\n  expect(out.status).toBe(\"complete\")\n  expect(out.summary).toContain(\"verilog counter\")\n  const opts = spawned[0]\n  expect(opts.agentOptions.provider).toBe(\"deepseek-official\")\n  expect(opts.agentOptions.model).toBe(\"deepseek-v4-flash\")\n  const prompt = opts.prompt[0].text\n  expect(prompt).toContain(\"You are the Deep Worker\")\n  expect(prompt).toContain(\"mpd_workmate_reflect\")\n  expect(prompt).toContain(\"verified\")\n  expect(opts.toolFilter).toBeUndefined() // non-readonly workmate keeps write tools\n\n  // readonly base → deny write tools\n  await byName(\"mpd_workmate_init\").execute({ base: \"librarian\", name: \"bob\" }, exec)\n  const readonlyOut = await byName(\"mpd_workmate_spawn\").execute({ name: \"bob\", task: \"search evidence\" }, exec)\n  expect(readonlyOut.status).toBe(\"complete\")\n  expect(spawned[1].toolFilter).toEqual({ deny: expect.arrayContaining([\"write\", \"edit\"]) })\n})\n\ntest(\"workmate library root is under HOME and not in cwd\", () => {\n  const home = sandboxHome()\n  const { byName, exec } = makePlugin()\n  void byName(\"mpd_workmate_init\").execute({ base: \"hephaestus\", name: \"zed\" }, exec)\n  const root = join(home, \".mpd\", \"workmate\")\n  expect(existsSync(root)).toBe(true)\n  expect(readdirSync(root)).toContain(\"zed\")\n  expect(process.env.HOME).toBe(home)\n  expect(PERSONA_CAP).toBeGreaterThan(0)\n})\n"}],"isError":false}],"role":"user","id":"2ba2e058-289e-4786-8b73-11aadd84c9f7"}},"sourceEventSeqs":[9706],"surfaceOp":"append"}
evidence/agent-teams/scheduler-wakeup-fix/2026-09-10T10-16-23Z/captain-session-f333e946.jsonl:512:{"type":"tool/result","seq":11688,"time":1789026781966,"data":{"turn":1,"step":8,"message":{"source":{"kind":"tool","callId":"call_00_ocRcV5ijtkw1nsqKos1c5135"},"content":[{"type":"tool-result","toolCallId":"call_00_ocRcV5ijtkw1nsqKos1c5135","content":[{"type":"text","text":"=== docs mentioning workmate ===\n./docs/development.md\n./docs/architecture.zh-CN.md\n./docs/architecture.md\n./docs/feature-audit.md\n./docs/user-guide.zh-CN.md\n./docs/feature-audit.zh-CN.md\n./docs/index.zh-CN.md\n./docs/rtl-gap-assessment.md\n./docs/rtl-gap-assessment.zh-CN.md\n./docs/user-guide.md\n./docs/index.md\n./docs/development.zh-CN.md\n./AGENTS.md\n./README.zh-CN.md\n./packages/mpd-bundle/README.zh-CN.md\n./packages/mpd-bundle/README.md\n./packages/mpd-bundle-plugin/README.zh-CN.md\n./packages/mpd-bundle-plugin/README.md\n./packages/mpd-workmate-plugin/README.zh-CN.md\n./packages/mpd-workmate-plugin/README.md\n\n=== AGENTS.md workmate lines ===\n53:  **workmate library** (`mpd-workmate-plugin`): a base can be instantiated into a\n54:  durable, evolving copy under `~/.mpd/workmate/` with an independent name, which\n56:  note; reuse is via `mpd_workmate_match` and weak matches must NOT be forced (initialize\n57:  a new workmate instead). The ONLY\n127:│   ├── mpd-workmate-plugin/      # durable evolving agent library (~/.mpd/workmate): base→instance, self-reflect (persona+memory capped), short note, reuse via mpd_workmate_* (no forced weak matches)\n129:│   ├── mpd-agent-teams-plugin/   # adopted dsh-agent-teams (MIT, first-class main code): agent_teams_* + the Web panel views/store the bundle's sidebar team page composes; memberPersona injects workmate backing\n130:│   ├── mpd-bundle-plugin/        # bundle web-compat: the @mpd-dsh/mpd no-op main + the combined web client (client.js = the AgentTeams sidebar page `@mpd-dsh/team-page` + the workmate library, both contributed as DSH-better-sidebar tabs and BOTH sidebar-only — no floating fallback for either; built by scripts/build-mpd-client.mjs)\n220:  version-stamped copies that bundle `<= 0.2.6` wrote; (2) the **workmate library**\n221:  (`mpd-workmate-plugin`) deliberately lives under the user's HOME (`~/.mpd/workmate`) —\n273:  Only user data stays: the workmate library under `~/.mpd/workmate`.\n343:| `mpd_workmate_*` reports \"mpdRoles service unavailable\" | the `mpd-roles` plugin row is not mounted (e.g. a legacy install without the roster) — add the `mpd-roles` row (bundle patch / install-profile); the workmate plugin resolves the service lazily at tool-execute time |\n346:| the Workmates tab is missing from the DSH-better-sidebar tab strip | the tab is contributed at client-apply time through `ctx.betterSidebar.registerTab` — check the boot log/console for `[mpd] better-sidebar not installed — the workmate library has no host (no floating fallback by design)` (the sidebar bundle is not composed) and that `packages/mpd-bundle-plugin/client.js` contains `SIDEBAR_TAB_ID = \"mpd-workmate\"` (rebuild with `node scripts/build-mpd-client.mjs`). There is NO fallback: a profile without that sidebar has no workmate GUI at all, exactly like the AgentTeams tab above — the overlay floater and the footer toggle were removed, and `scripts/build-mpd-client.mjs` fails the build if any client source registers them again. `bun test packages/mpd-bundle-plugin/test/sidebar-tab.test.mjs` pins the tab and the absent fallback |\n350:| web team/workmate panel never appears in the GUI | the bundle's web client has no loader entry named exactly `@mpd-dsh/mpd` — client-modules builds client rows from `ctx.loader.entries()` entry names, which come from patch rows' `name` field; keep the `mpd-web-compat` self-row (`name: '@mpd-dsh/mpd'`) and the bundle `main`/`exports[\".\"]` pointing at `packages/mpd-bundle-plugin` (regenerate with `node scripts/build-mpd-client.mjs && node scripts/pack-mpd.mjs`) |\n369:- workmate: a durable, evolving agent instance in `~/.mpd/workmate/` created by\n370:  `mpd-workmate-plugin` (`mpd_workmate_*`) from a roster BASE template with an\n372:  size-capped) and keeps a short note card. Reuse is via `mpd_workmate_match`; weak\n373:  matches must NOT be forced — initialize a new workmate instead.\n\n=== mpd-workmate-plugin README size ===\n  63 packages/mpd-workmate-plugin/README.md\n  48 packages/mpd-workmate-plugin/README.zh-CN.md\n 111 total\n"}],"isError":false}],"role":"user","id":"a0f892eb-2cc7-4416-986b-84df32ed77fb"}},"sourceEventSeqs":[11687],"surfaceOp":"append"}
evidence/agent-teams/scheduler-wakeup-fix/2026-09-10T10-16-23Z/captain-session-f333e946.jsonl:562:{"type":"agent/inbox/spliced","seq":12878,"time":1789026849343,"data":{"target":"next-step","start":0,"inserted":[{"content":[{"type":"text","text":"Agent 8fdfdfd4-308b-4ab3-b12f-21bf5997f1ae sent a message:"},{"type":"text","text":"PLAN REVIEWER (momus) — adversarial REQUIREMENTS INTERROGATION for \"rename a workmate + delete a workmate\" (repo /root/dshProj/my-power-dsh). Read-only; read src/index.ts (439L), web-client.js, members.js, tests, QA scripts. No plan proposed.\n\n## (1) USER QUESTIONS — only the human can decide\n\nQ1 AUTHORITY / SURFACE. Should rename+delete be agent-callable tools (`mpd_workmate_rename`/_delete), GUI-only human actions, or both?\n- Why: the library is the agent's own durable cross-project memory; an agent tool lets any captain/teammate autonomously destroy months of evolved persona+memory. Also relevant: AGENTS.md §6 forbids plugins writing outside the workspace EXCEPT this library — the write authority question is genuinely product-level.\n- Candidates: (a) both, tools exist but destructive call requires an explicit `confirm:\"<name>\"` argument; (b) both, unguarded; (c) GUI-only (no agent tools at all); (d) tools only, no GUI change.\n\nQ2 DELETE REVERSIBILITY. Hard `rm -rf` or recoverable?\n- Why: memory.md is accumulated evidence that cannot be regenerated from the base template; a mis-click permanently loses it. Also index.json / any future consumer.\n- Candidates: (a) hard delete; (b) move to `~/.mpd/workmate/.trash/<name>-<ISO>/` (restorable, hidden from list); (c) rename-to-tombstone + keep dir, hidden; (d) hard delete but behind a typed-name confirmation.\n\nQ3 RENAME SEMANTIC SCOPE. What exactly must move, and does the workmate's own text follow?\n- Why: the name is embedded in artifacts — `autoNote()` writes `<baseName>-based workmate \"<name>\".` into note.md, and persona/memory may quote the old name in agent-written text. Silent drift confuses both the matching score and the human.\n- Candidates: (a) dir + meta.name + index key only (stale note text accepted); (b) also rewrite the auto-note self-reference; (c) also append a `## Renamed <old> → <new>` memory entry and/or a `previousNames`/`renamedFrom` field so continuity is visible; (d) grep-replace the old name inside persona/memory. Plus: does rename bump `updatedAt` (it re-sorts the list) and does it count as a `uses` bump? (No.)\n\nQ4 LIVE TEAM-MEMBER BINDING. What happens when the renamed/deleted workmate's name equals a member of a live or archived team?\n- Why: binding is name-equality only — `packages/mpd-agent-teams-plugin/lib/members.js#workmateBacking` hashes the member name to the dir; the team file persists that member name. A rename silently strips the backing from a running member; a delete does the same; afterwards that member's `mpd_workmate_reflect` FAILS (ensureInstance throws \"no workmate named\"). Highest-risk case: a workmate named exactly a roster normal name (e.g. `senior-engineer`) is auto-bound to EVERY member called \"Senior Engineer\" in every `mpd`-profile team.\n- Candidates: (a) silent (member keeps the already-injected persona; later reflect errors); (b) pre-check `.mpd/team/*/team.json` and REFUSE while a live team has such a member; (c) warn in the response and proceed; (d) cascade — rewrite team member names for rename (delete cannot cascade).\n- Related sub-decision: for a rename, does the member follow automatically (alias) or must the user re-add the member?\n\nQ5 OLD NAME AFTER RENAME (REUSE + IDENTITY SWAP). Is the old name freed immediately?\n- Why: if freed, a later `mpd_workmate_init` can create a *different* workmate under the old name and every existing team member named that way silently re-binds to the new persona/memory — an invisible identity swap.\n- Candidates: (a) free immediately; (b) reserve/tombstone in index.json (old name resolves as an alias to the new one; member binding follows the alias); (c) free but record a tombstone so `init` warns \"name previously used by X\".\n\nQ6 NAME INPUT CONTRACT FOR RENAME. Strict-reject or silent-normalize, and are non-ASCII names supported?\n- Why: `sanitizeName()` lowercases, kebab-cases, strips everything outside `[a-z0-9_-]` — a Chinese name such as 助理 sanitizes to \"\" and `wmDir(\"\")` is the LIBRARY ROOT, so an unguarded empty key can target/recurse the whole library. Since the requester writes Chinese, they may expect CJK names — supporting them means changing the key scheme in BOTH plugins (members.js `workmateKey` must stay byte-identical).\n- Candidates: (a) strict: reject invalid/empty/no-op/colliding names with a clear error (CJK unsupported, documented); (b) silent sanitize + error only on empty/collision; (c) allow Unicode dir names (new key scheme, cross-plugin change); (d) sanitize + auto-suffix like init's `base-N` when the name is empty or taken. Also decide: rename to the same sanitized name = error or 200 no-op? Collision with an existing workmate = refuse or merge?\n\nQ7 GUI BEHAVIOR. Where do the controls live and how is delete confirmed?\n- Why: this is the actual human-facing half of the request (\"可以改名 / 可以删除\"); the tab is DSH-better-sidebar-only, `single: true`, and its dictionaries are zh+en with zh as key-set source of truth (both must land in the same change, and `client.js` must be rebuilt or the tab shows nothing new).\n- Candidates: (a) buttons in the detail view only; (b) inline per-row controls in the list; (c) native confirm / typed-name confirm / two-step (arm-then-confirm) for delete; and after rename: does the open detail view follow to the new name or return to the list? Undo/toast, or none?\n\nQ8 SCOPE OF THE TRAVERSAL-DISCOVERED DEFECT. The deny lists in mpd-workmate-plugin (line 30) AND mpd-roles-plugin (line 23-27) name tools this harness does not have (`str_replace_editor`, `apply_patch`), and the harness rejects the whole restriction call — so read-only workmate spawn and `mpd_role_spawn` fail today. In this change or not?\n- My recommendation for the user to rule on: OUT of scope (separate `fix/` branch per AGENTS.md §5) — different package, different failure mode, minimal-diff principle §2.6. Caveat that argues for IN: with the defect live, a readonly workmate cannot be spawned at all, so end-to-end acceptance evidence for rename/delete on readonly instances is unreachable.\n- Candidates: (a) separate defect branch (recommended); (b) same change, both plugins; (c) same change, only the workmate plugin's list.\n\n## (2) EDGE CASES THE IMPLEMENTATION MUST HANDLE\n- EMPTY SANITIZED NAME: `sanitizeName(x) === \"\"` (e.g. CJK, punctuation-only, whitespace) must be rejected BEFORE any fs call — `wmDir(\"\")` is `~/.mpd/workmate` itself, so delete would target the library root and rename would move it.\n- Path containment: the resolved target must be a strict child of the library root and must not be `index.json` or any non-directory entry.\n- Unknown name → explicit error, zero side effects; delete must not silently \"succeed\"; a second delete must error.\n- Half-created / corrupt instance: a dir under the root with no meta.json (crash between `mkdirSync` and the meta write at init) — `listInstances` skips it, so rename/delete must decide: error, or allow cleanup of the orphan dir.\n- Rename collision: target name already exists (or a *file* of that name exists) → refuse, mirroring init's `already exists` error.\n- Sanitization collision: two distinct inputs mapping to the same key (\"Alice Cooper\" vs \"alice-cooper\" vs \"Alice  Cooper\").\n- Case-only rename: \"Alice\" → \"alice\" is a sanitize-no-op on a case-insensitive filesystem — must be a defined outcome, not a rename-to-itself ENOENT.\n- index.json consistency: it has NO reader today (`indexPath()`/`writeIndexEntry` are the only references — verified by grep), yet rename must remove the old key and add the new one, and delete must drop the key, or the file becomes permanently stale; also decide whether index.json is authoritative at all.\n- Atomicity/partial failure: rename across the same fs is one `renameSync`, but meta.name + index write can fail after the dir moved → must not leave a dir whose name and meta.name disagree; delete must not leave a half-removed dir (nested persona/memory files).\n- Symlinks: a workmate dir that is a symlink (or contains one) must not let delete/rename escape the library root.\n- Race with in-flight work: `mpd_workmate_spawn` reads persona/memory then the subagent calls `mpd_workmate_reflect` LATER, while `reflect` does readMeta → mutate → `writeFileSync(join(wmDir(meta.name)...))`. A reflect racing a rename recreates the OLD directory (name resurrection); a reflect after delete throws. Must be a defined outcome (reject-in-flight vs last-writer-wins).\n- Service consistency: `mpdWorkmate.get(old)` must return null and `.get(new)`/`.read(new)` the full detail immediately after the mutation; `list` must reflect it on the very next call (no caching).\n- Cross-module: team-member backing (`members.js`) resolves merely by dir existence — after rename the member loses backing silently, and a workmate whose key equals a roster normal name (`senior-engineer`, `deep-worker`) affects every team using that member name.\n- Readonly instances: their persona says \"never modify anything\" — rename/delete are library-admin ops, not workmate self-edits; the agent-tool path must not be usable by a readonly workmate to mutate the library.\n- Web routes: method guard (405 on wrong verb), 400 on invalid JSON, 404 on unknown name (mirror the existing `/get` route's 404 shape), `cache-control: no-store`, and no absolute `$HOME` path leaking in the response (note: `initWorkmate` already returns `path`, so decide deliberately rather than by accident).\n- Route/plugin lifecycle: routes are registered lazily via `ctx.get(\"webServer\" ?? \"httpServer\")` behind `webRegistered`; a headless profile has no routes at all — rename/delete must still work tool-only.\n- GUI: stale selection after mutation (detail must not keep polling a deleted/old name and must not 404-loop); the `single: true` tab must not open a second tab; new zh AND en keys are mandatory (zh is the key-set source of truth) and `node scripts/build-mpd-client.mjs` must be re-run or the shipped `client.js` shows nothing.\n- Names that collide with the roster base ids/normal names and with existing workmate auto-names (`hephaestus-1`) — dedupe/auto-suffix logic must not overwrite.\n- Deletion must not be reachable by the agent through `mpd_workmate_reflect`/`init` side effects (e.g. reflect on a missing name must not \"recreate\" the instance).\n- Docs/tests to keep in sync (not optional, they are gates): package README.md + README.zh-CN.md, docs/user-guide.md + .zh-CN, AGENTS.md workmate tool list/glossary/troubleshooting, the preset text (`presets/mpd/agent.cordis.yml` + the `mpd` roster profile protocol string in `packages/mpd-bundle/cordis.patch.yml`), the QA self-tests that string-match the workmate source/routes (`skills/dsh-qa/scripts/workmate-library.mjs` asserts the list/roster/get route literals; `web-client-adapt.mjs` asserts list+init), and `packages/mpd-bundle-plugin/test/sidebar-tab.test.mjs`.\n\n## (3) INVARIANTS ACCEPTANCE MUST PIN\nI1 NAME↔DIR↔INDEX BIJECTION AND ROOT SAFETY. For every workmate at all times: `sanitizeName(meta.name)` === dir basename === the index.json key; after a rename the old key and old dir are gone; and no operation may ever resolve to, move, or recursively remove the library root itself — an empty/invalid sanitized name is rejected with zero side effects. (Pins the `wmDir(\"\")===root` hazard; must hold identically in both plugins via the byte-identical `sanitizeName`/`workmateKey` algorithm.)\nI2 RENAME IS IDENTITY-PRESERVING, NEVER A RE-INSTANTIATION. Rename carries the exact same instance: persona.md / memory.md / note.md content and length caps, `uses`, `lastTask`, `createdAt` all preserved (only the explicitly-decided self-references/`renamedFrom` metadata change); no base re-copy, no memory reset, no `uses` bump — a renamed workmate is byte-for-byte the same evolved agent under a new key.\nI3 DELETE IS COMPLETE AND ALL-OR-NOTHING. After a successful delete: the instance dir is gone, its index entry is gone, `mpdWorkmate.get`/`read` return null, `list` no longer contains it, and NO other workmate's bytes changed; for an unknown/empty/invalid name the operation fails with a clear error and zero side effects; a failed delete never leaves a partially removed instance.\nI4 CROSS-MODULE BINDING OUTCOME IS DETERMINISTIC AND TEST-PINNED. Whatever Q4/Q5 decide (silent / refuse / alias / cascade), the observable result for a team member whose name equals a mutated workmate, and for the `mpdWorkmate` service + `mpd_workmate_list`/`_match` views, must be exactly that decision at all times — no state where the dir, index.json, the service view and the member's injected backing disagree — and a test must pin it (offline lifecycle test in packages/mpd-workmate-plugin/test/workmate.test.ts + a QA self-test/real-boot row), with the real $HOME untouched (sandbox HOME).\n\nGate reminders for acceptance: `bun test`, `bun run typecheck`, `bun run test:qa`, `node scripts/verify-vendor.mjs`, `dsh --profile headless --dump-config` in an isolated DSH_HOME, evidence under evidence/<domain>/<slug>/<timestamp>/, bilingual docs in the same commit."}],"source":{"kind":"agent-message","form":"relay","senderSessionId":"8fdfdfd4-308b-4ab3-b12f-21bf5997f1ae"},"role":"user","id":"4181fef7-2f62-4c86-97bb-e166bb179642"}]}}
