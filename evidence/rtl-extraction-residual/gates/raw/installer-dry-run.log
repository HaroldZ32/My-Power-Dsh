- insert:
  - id: mpd-web-compat
    name: "@mpd-dsh/mpd"
  - id: mcp-astgrep
    name: "@deepseek-ai/dsh-mcp-client"
    config:
      serverName: "ast_grep"
      transport: "stdio"
      command: "node"
      args:
        - "/root/dshProj/my-power-dsh/packages/mpd-mcp-astgrep/dist/cli.js"
      env:
        MPD_AST_GREP_SG_PATH: "/root/dshProj/my-power-dsh/.toolchain/node_modules/.bin/sg"
      toolCallTimeoutMs: 60000
  - id: mcp-gitbash
    name: "@deepseek-ai/dsh-mcp-client"
    disabled: true
    config:
      serverName: "git_bash"
      transport: "stdio"
      command: "node"
      args:
        - "/root/dshProj/my-power-dsh/packages/mpd-mcp-gitbash/dist/cli.js"
      toolCallTimeoutMs: 60000
  - id: mcp-lsp
    name: "@deepseek-ai/dsh-mcp-client"
