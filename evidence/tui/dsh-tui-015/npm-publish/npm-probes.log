    validateUUID(stageId, 'stage-id')
    const opts = { ...this.npm.flatOptions }

    log.notice('', `Approving staged package ${stageId}`)

    await otplease(this.npm, opts, o =>
      npmFetch.json(`/-/stage/${stageId}/approve`, {
        ...o,
        method: 'POST',
      })
    )

