+function seedJournal(harness: Harness, rows: Array<Record<string, unknown>>): void {
+  writeFileSync(journalPath(harness.workspace, CELL_ID), rows.map((row) => JSON.stringify({ at: "2026-11-11T00:02:00.000Z", ...row }) + "\n").join(""), "utf8")
