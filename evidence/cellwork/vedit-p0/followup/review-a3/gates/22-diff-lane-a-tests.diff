+  // 500 ms bound cannot see; recording WHICH event comes first can. Only the barrier's OWN delay is
+  // recorded, so an unrelated runtime timer can never be mistaken for the seam under test.
+  globalThis.setTimeout = ((callback: (...args: never[]) => void, ms?: number, ...rest: never[]) => {
+    if (ms === DELAY_MS) timeline.push("delay")
+    return realSetTimeout(callback as never, ms, ...(rest as never[]))
