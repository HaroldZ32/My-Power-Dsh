// CELLWORK FLOW — the four tools that carry the cell through B4–B7, and their ONE registration site.
//
//   cellwork_requirements  (planner)   finalize/update the agreed requirements document
//   cellwork_recon         (planner / subcaptain)   one-shot read-only consult
//   cellwork_split         (splitter)  submit/show the measured task graph
//   cellwork_activate      (captain)   materialise an accepted split on the LIVE team record
//
// The planning team's STAGING is not a tool of its own: `cellwork_start` performs it (Amendment 3), and
// this module exports the pieces `index.ts` calls. Everything here reaches the harness through the
// adapter ONLY (`dsh.executeTool`, `dsh.teamExecutor`, `dsh.registerTool`); the three services it reads
// (`mpdTeams`, `mpdRoles`, `mpdConsults`) and the config service are declared STRUCTURALLY, because the
// cross-package coupling inventory is frozen and may only shrink. No consult is raised here any more: the
// two new tools and `cellwork_recon` go through `mpdConsults`, which is the roles row's ONE supervisor.
import { appendJournal, listCellIds, readCell, writeCell, requirementsPath, resolveCellTeam, type CellReadFailure, type CellState, type CellMemberRecord, type CellTeamResolution } from "./state"
import { callerContext, type TeamActionsServiceView, sessionIdOf, type CallerContext, type TeamsServiceView } from "./caller"
import { liveNumericKnob, type CellworkConfig } from "./config"
import { readRequirements, storedRequirementsText, validateRequirementsText, writeRequirements } from "./requirements"
import { latestSplit, readSplit, submitSplit, type SplitSubmission, type SplitTaskInput, type SplitVerdict } from "./split"
import { resolveTaskWindow, type RouteResolutionView, type WindowReading } from "./budget"
import { runRecon } from "./recon"
import {
  CONSULT_ACTIONS,
  CONSULT_WAIT_DEFAULT_MS,
  CONSULT_WAIT_MAX_MS,
  consultSeatRefusal,
  createConsultBook,
  clearCellConsults,
  runConsultAction,
  startDelegation,
  type ConsultServiceView,
} from "./consults"
import { materializeSplit, type ActivatePartial, type ActivateProgress, type ActivateResult } from "./activate"
import { PLANNER_MEMBER, SPLITTER_MEMBER, findSplitTicket } from "./staging"
import type { DshAdapter, DshToolExec } from "../../mpd-dsh-adapter-plugin/src/index"

/** The slice of the `mpdRoles` service this module reads (declared here, never imported). */
interface RosterServiceView {
  /** The full roster: the names and persona texts an owner role is validated against. */
  list?: () => Array<{ name?: string; persona?: string }>
  /** One role by name, carrying its persona text. */
  get?: (key: string) => { name?: string; persona?: string } | null
}

/** The slice of the `mpdConfig` service this module reads. */
interface ConfigServiceView {
  /** Read one dotted `mpd.jsonc` key. */
  get?: (dottedKey?: string) => unknown
  /** Resolve one roster agent's own `agentRoutes` entry (the route its window comes from). */
  agentRouteResolutionOf?: (member: string) => unknown
}

/** The host context this module reads; the adapter owns every harness seam behind it. */
export interface FlowCtx {
  /** The service lookup a row uses; a second argument of `false` means "absent is not an error". */
  get?: (serviceName: string, strict?: boolean) => unknown
}

/** What {@link installCellworkFlow} needs from the row. */
export interface FlowDeps {
  /** The resolved adapter (the ONE harness contact surface). */
  dsh: DshAdapter
  /** The host context, read only for the two MPD services and the config service. */
  ctx: FlowCtx
  /** The resolved knobs. */
  config: CellworkConfig
  /** The row's log sink. */
  warn: (line: string) => void
  /**
   * Receives the cell-end consult cleanup, so `cellwork_stop` can clear this row's consult book.
   *
   * WHY A CALLBACK AND NOT A RETURN VALUE: the stop tool is registered in the row's entry module, which
   * never sees the book — the book belongs to these tools. Handing the cleanup back at install time keeps
   * the book private to this module and gives the stop path exactly one function to call.
   */
  onConsultStop?: (hook: (cell: { cellId: string; teamId: string; workspace: string }) => Promise<void>) => void
}

/** One flow tool's answer: a structured success (any documented fields) or the refusal sentence. */
type FlowResult = Record<string, unknown> | FlowFailure

/** The refusals every flow tool answers with — never a throw, so the model can act on the sentence. */
interface FlowFailure {
  /** Always false. */
  ok: false
  /** ONE sentence naming what was refused and what to do instead. */
  error: string
  /** The state path, when the refusal is about a record this build could not read. */
  path?: string
  /**
   * The execution team a FAILED activation minted before it stopped (blind review H1).
   *
   * The id is persisted on the cell record anyway; naming it here too means the captain sees WHICH team
   * the retry will address without reading the record first.
   */
  mintedTeamId?: string
}

/**
 * The workspace-relative spelling of a stored split verdict's own file.
 *
 * A REFUSED resubmission of an already-accepted revision lands beside the canonical file (Amendment 6
 * R2), so the path is read from the verdict instead of being rebuilt from its revision.
 *
 * @param workspace - the caller's workspace root.
 * @param verdict - the stored verdict whose path is wanted.
 * @returns the path relative to the workspace, or the absolute path for a verdict outside it.
 */
function splitPathFor(workspace: string, verdict: SplitVerdict): string {
  /** The path the verdict was persisted to, when it recorded one. */
  const file = verdict.file
  if (file === undefined || file === "") return [".mpd", "cellwork", verdict.cellId, "split", String(verdict.revision) + ".json"].join("/")
  /** The workspace prefix both spellings share, normalized once. */
  const prefix = workspace.endsWith("/") ? workspace : workspace + "/"
  return file.startsWith(prefix) ? file.slice(prefix.length) : file
}

/**
 * Read one tool's arguments as a record.
 *
 * @param args - the harness-validated arguments (the schema is not enforced inside the handler).
 * @returns the arguments, or an empty record.
 */
function readArgs(args: unknown): Record<string, unknown> {
  return typeof args === "object" && args !== null && !Array.isArray(args) ? args as Record<string, unknown> : {}
}

/**
 * Read one string field from untrusted arguments.
 *
 * @param args - the argument record.
 * @param key - the field name.
 * @returns the string, or "" when absent or not a string.
 */
function argString(args: Record<string, unknown>, key: string): string {
  return typeof args[key] === "string" ? args[key] as string : ""
}

/**
 * Read one string array from untrusted arguments.
 *
 * @param value - the raw argument value.
 * @returns the trimmed non-empty strings; `[]` for anything else.
 */
function stringList(value: unknown): string[] {
  return Array.isArray(value) ? value.filter((entry): entry is string => typeof entry === "string" && entry.trim() !== "").map((entry) => entry.trim()) : []
}

/**
 * The sentence a refusing cell read answers with.
 *
 * @param failure - the failed read.
 * @returns the refusal naming the path and the reason.
 */
function refusalText(failure: CellReadFailure): string {
  return "the cell record at " + failure.path + " cannot be read (" + failure.reason + ": " + failure.detail + ") — nothing was changed; repair or archive that file first"
}

/**
 * Read one team record through the service, tolerating every failure.
 *
 * @param teams - the team service view, when mounted.
 * @param workspace - the caller's workspace root.
 * @param teamId - the team id; "" answers undefined.
 * @returns the record, or undefined.
 */
function recordOf(teams: TeamsServiceView | undefined, workspace: string, teamId: string): Record<string, unknown> | undefined {
  if (teams === undefined || teamId === "" || workspace === "") return undefined
  /** The service's own read, total by contract. */
  const record = teams.get?.(workspace, teamId)
  return typeof record === "object" && record !== null ? record as Record<string, unknown> : undefined
}

/**
 * The board tasks of one team record, as records.
 *
 * @param record - the team record, or undefined.
 * @returns the task rows this build can read.
 */
function boardTasksOf(record: Record<string, unknown> | undefined): Array<Record<string, unknown>> {
  return record !== undefined && Array.isArray(record.tasks) ? record.tasks.filter((row): row is Record<string, unknown> => typeof row === "object" && row !== null) : []
}

/**
 * Install the four flow tools.
 *
 * @param deps - the adapter, the host context, the knobs and the log sink.
 * @returns one disposer per registration.
 */
export function installCellworkFlow(deps: FlowDeps): Array<() => void> {
  /** The adapter, named once so the tool bodies read cleanly. */
  const dsh = deps.dsh
  /** The resolved knobs. */
  const config = deps.config
  /** Every registration's disposer. */
  const disposers: Array<() => void> = []
  /** The team service, probed per call (the team row may activate after this one). */
  const teams = (): TeamsServiceView | undefined => {
    /** The service object, or undefined. */
    const service = deps.ctx.get?.("mpdTeams", false)
    return typeof service === "object" && service !== null ? service as TeamsServiceView : undefined
  }
  /** The TEAM-PLANE write service, probed per call (wave W2-D: the plane owns dispatch and cancel). */
  const teamActions = (): TeamActionsServiceView | undefined => {
    /** The service object, or undefined. */
    const service = deps.ctx.get?.("mpdTeamActions", false)
    return typeof service === "object" && service !== null ? service as TeamActionsServiceView : undefined
  }
  /**
   * Resolve the team this cell's board is CURRENTLY on (§7.1a site 7).
   *
   * WHY EVERY BOARD READ GOES THROUGH THIS: the record's `teamId` is only the FAST PATH. Activation can
   * land the execution board on a team the record never learned (the field defect), and a legacy cell
   * carries that old shape. The resolver verifies the recorded id against the cell's `activatedTasks`
   * and the plane, falls back to `planningTeamId`, and names BOTH ids when they disagree instead of
   * silently preferring one.
   *
   * @param workspace - the caller's workspace root.
   * @param cell - the cell record whose board is being read.
   * @returns the resolution: the winning team id, the evidence behind it, and the optional both-ids note.
   */
  const boardOf = (workspace: string, cell: CellState): CellTeamResolution =>
    resolveCellTeam({ workspace, cell, teams: teams(), recordFor: (teamId: string) => recordOf(teams(), workspace, teamId) })
  /** The roster service, probed per call. */
  const roster = (): RosterServiceView | undefined => {
    /** The service object, or undefined. */
    const service = deps.ctx.get?.("mpdRoles", false)
    return typeof service === "object" && service !== null ? service as RosterServiceView : undefined
  }
  /**
   * The `mpdConsults` service, probed per call.
   *
   * Lazy for the same reason as `mpdTeams`: the roles row may activate after this one, and a service
   * captured at apply time would then be a permanent absence. Undefined is the documented degradation —
   * every consult verb answers it with a refusal naming the missing row, never an unsupervised spawn.
   */
  const consults = (): ConsultServiceView | undefined => {
    /** The service object, or undefined. */
    const service = deps.ctx.get?.("mpdConsults", false)
    return typeof service === "object" && service !== null ? service as ConsultServiceView : undefined
  }
  /**
   * The process-local record of which consults THIS cell started through `cellwork_delegate`.
   *
   * Per row, not per cell: it holds ids only (no report, no state, no cap), it is never persisted, and it
   * dies with the process exactly as the supervisor's own records do (contract §3.4).
   */
  const consultBook = createConsultBook()
  // THE CELL-END CLEANUP (contract §5.3): the stop tool owns the transition, this module owns the book.
  deps.onConsultStop?.(async (cell) => {
    // THE CALLER'S WORKSPACE travels with the call: the stop tool resolved it for ITS invocation, and the
    // adapter's exec-less root would be a different tree in a multi-session host.
    // THE LIVE SERVICE TRAVELS TOO (R7.5): stopping a cell interrupts the children its book names, so the
    // resolver — not a captured service — is handed over and probed at the moment of the stop.
    await clearCellConsults({ book: consultBook, cellId: cell.cellId, workspace: cell.workspace, teamId: cell.teamId, teamActions, consults, now: new Date() })
  })
  /** The config service, probed per call. */
  const configService = (): ConfigServiceView | undefined => {
    /** The service object, or undefined. */
    const service = deps.ctx.get?.("mpdConfig", false)
    return typeof service === "object" && service !== null ? service as ConfigServiceView : undefined
  }
  /**
   * Read one dotted `mpd.jsonc` key, TOTAL: an absent or unreadable config layer answers undefined.
   * @param dottedKey - the full key, e.g. `cellwork.consultMax`.
   * @returns the declared value, or undefined.
   */
  const readConfig = (dottedKey: string): unknown => {
    try {
      return configService()?.get?.(dottedKey)
    } catch {
      // An unreadable config layer is a composition fact, never a reason to refuse a consult.
      return undefined
    }
  }
  /**
   * The numeric knob THIS call must use (§6.2), re-read from the workspace file so an edit applies at once.
   *
   * The mount-time value is the fallback layer, so a row-config value still governs when the file says
   * nothing and a malformed file value warns once instead of silently changing the budget.
   * @param key - the resolved knob's field name.
   * @returns the value in force for this call.
   */
  const knobOf = (key: "consultMax" | "delegateMaxTasks" | "reconMaxQuestions"): number =>
    liveNumericKnob(key, config, readConfig, deps.warn)
  /** The roster role names, or [] when the roster service cannot answer. */
  const rosterNames = (): string[] => {
    try {
      /** The roster rows. */
      const rows = roster()?.list?.()
      return Array.isArray(rows) ? rows.map((row) => String(row.name ?? "")).filter((name) => name !== "") : []
    } catch {
      return []
    }
  }
  /** The persona text for one roster role, or null when the roster service cannot answer. */
  const personaFor = (label: string): string | null => {
    try {
      /** The role row. */
      const role = roster()?.get?.(label)
      return role !== null && role !== undefined && typeof role.persona === "string" && role.persona.trim() !== "" ? role.persona : null
    } catch {
      return null
    }
  }
  /**
   * The refusal a cell-scoped consult verb answers when no LIVE cell is running on this workspace.
   *
   * A STOPPED cell is named as such: resolution skips it (it is no longer active), but the contract
   * refuses consult work after the mode ends, and "no active cell" would hide why.
   *
   * @param context - the caller's resolved context.
   * @param toolName - the tool answering.
   * @returns the refusal sentence, or undefined when a live cell exists.
   */
  const noLiveCellRefusal = (context: CallerContext, toolName: string): string | undefined => {
    if (context.workspace !== "" && context.cell !== null) return undefined
    if (context.workspace === "") return toolName + ": the workspace root could not be resolved, so no cell can be read"
    /** The cell ids this workspace still holds, newest last. */
    const ids = listCellIds(context.workspace)
    for (const id of ids) {
      /** That cell's record, when it can be read. */
      const read = readCell(context.workspace, id)
      if (read.ok && read.state.phase === "stopped") return toolName + ": cell " + id + " is stopped and archived — consult work is refused after the mode ends"
    }
    return toolName + ": no active cell in this workspace — the consult verbs are only callable inside a running cell"
  }
  /** The route one role resolves to, or undefined when the config service cannot answer. */
  const routeOf = (role: string): RouteResolutionView | undefined => {
    try {
      /** The service carrying the resolver. */
      const service = configService()
      /** The resolver, when the service exposes one. */
      const resolve = service?.agentRouteResolutionOf
      if (typeof resolve !== "function") return undefined
      /** The service's own answer. */
      const answer = resolve.call(service, role)
      return typeof answer === "object" && answer !== null ? answer as RouteResolutionView : undefined
    } catch {
      return undefined
    }
  }
  /** Read one role's window from the catalog (or the operator override). */
  const windowFor = async (role: string): Promise<WindowReading> =>
    resolveTaskWindow({ routeOf, catalog: () => dsh.llmCatalog(), config }, role)
  /** The caller's context for one dispatch. */
  const callerFor = (exec: DshToolExec): CallerContext => callerContext(dsh, exec, { teams })
  /**
   * Persist one transition: journal first, then the record (a torn journal costs one history line).
   *
   * @param workspace - the caller's workspace root.
   * @param next - the record after the transition.
   * @param entry - the journal fields.
   * @param now - the instant to stamp.
   * @returns the record as persisted.
   */
  const transition = (workspace: string, next: CellState, entry: Record<string, unknown>, now: Date): CellState => {
    /** The journal line count after the append. */
    const lines = appendJournal(workspace, next.cellId, entry, now)
    /** The record carrying the updated cursor. */
    const stamped: CellState = { ...next, journalCursor: lines > 0 ? lines : next.journalCursor }
    writeCell(workspace, stamped)
    return { ...stamped, updatedAt: now.toISOString() }
  }
  /**
   * Complete one cell task through the team plane, reporting rather than throwing on failure.
   *
   * @param exec - the calling dispatch (its agent is the task's owner).
   * @param teamId - the team the task is on.
   * @param predicate - which board task to close.
   * @param note - the closure note.
   * @returns the task id closed, or undefined when nothing matched or the call failed.
   */
  const completeCellTask = async (
    exec: DshToolExec,
    teamId: string,
    predicate: (row: Record<string, unknown>) => boolean,
    note: string,
  ): Promise<string | undefined> => {
    /** The live record. */
    const record = recordOf(teams(), dsh.workspaceRoot(exec), teamId)
    /** The first non-terminal task matching the predicate. */
    const row = boardTasksOf(record).find((candidate) => predicate(candidate) && candidate.status !== "completed" && candidate.status !== "failed" && candidate.status !== "cancelled")
    if (row === undefined) return undefined
    /** The board id. */
    const taskId = String(row.id ?? "")
    if (taskId === "") return undefined
    /** The completion call, run under the caller's own identity (the task's owner). */
    const result = await dsh.executeTool({ name: "agent_teams_task", arguments: { action: "complete", task_id: taskId, note }, agent: exec.agent })
    return result.ok ? taskId : undefined
  }

  // ── cellwork_requirements ────────────────────────────────────────────────
  disposers.push(dsh.registerTool({
    name: "cellwork_requirements",
    description: "The PLANNER's tool (cell-planner only): `finalize` the agreed requirements document or `update` it. Validates the six required sections (goal, non-goals, users/consumers, constraints, acceptance criteria, open questions). `finalize` refuses an incomplete document and completes the requirements task; `update` bumps the revision and marks the current split STALE.",
    parameters: {
      type: "object",
      properties: {
        action: { type: "string", enum: ["finalize", "update"], description: "finalize the agreed document, or update it (bumps the revision, marks the split stale)." },
        content: { type: "string", description: "The full markdown document. Omit to validate the file already at <cell>/requirements.md." },
      },
      required: ["action"],
      additionalProperties: false,
    },
    output: {
      schema: {
        type: "object",
        properties: {
          ok: { type: "boolean" },
          error: { type: "string" },
          path: { type: "string" },
          action: { type: "string" },
          revision: { type: "number" },
          splitStale: { type: "boolean" },
          alreadyFinalized: { type: "boolean" },
          missing: { type: "array", items: { type: "string" } },
          sections: { type: "array", items: { type: "object" } },
          requirementsPath: { type: "string" },
          splitTaskId: { type: "string" },
          splitTaskStatus: { type: "string" },
          redispatchable: { type: "boolean" },
          replacementSplitTaskId: { type: "string" },
          recordedSplitTaskId: { type: "string", description: "The split ticket id the cell record carries after this update — the row the NEXT update reuses." },
          closedTaskId: { type: "string" },
          boardNote: { type: "string", description: "Present only when the record's teamId and the resolved board DISAGREE: names both ids and the resolution that won (§7.1a)." },
        },
        required: ["ok"],
      },
      render: (_args: unknown, value: unknown): unknown => {
        /** The result as a record. */
        const result = typeof value === "object" && value !== null ? value as Record<string, unknown> : {}
        if (result.ok === false) return text("cellwork_requirements refused: " + String(result.error ?? "unknown refusal") + (Array.isArray(result.missing) && result.missing.length > 0 ? "\nmissing sections: " + result.missing.join(", ") : ""))
        return text("requirements " + String(result.action ?? "") + ": revision " + String(result.revision ?? "?") + (result.alreadyFinalized === true ? " (already finalized)" : "") + (result.splitStale === true ? " — the accepted split is STALE and must be re-submitted" : "") + (typeof result.closedTaskId === "string" ? " · requirements task " + result.closedTaskId + " completed" : "") + (typeof result.boardNote === "string" ? "\nBOARD: " + result.boardNote : ""))
      },
    },
    execute: async (args: unknown, exec: DshToolExec): Promise<FlowResult> => {
      /** The argument record. */
      const argv = readArgs(args)
      /** The requested action. */
      const action = argString(argv, "action")
      /** The caller's context. */
      const caller = callerFor(exec)
      if (caller.refusal !== null) return { ok: false, error: refusalText(caller.refusal), path: caller.refusal.path }
      if (caller.workspace === "" || caller.cell === null) return { ok: false, error: "cellwork_requirements: no active cell in this workspace — the tool is only callable inside a running cell" }
      /** The active cell's record. */
      const state = caller.cell
      if (state.phase === "stopped") return { ok: false, error: "cellwork_requirements: cell " + state.cellId + " is stopped and archived" }
      if (caller.member !== PLANNER_MEMBER) {
        return { ok: false, error: "cellwork_requirements is PLANNER-ONLY: this session is " + JSON.stringify(caller.member === "" ? "not a cell member" : caller.member) + ". The captain authors nothing (clause 1); the planner writes and finalizes the document, and the captain relays the user's answers." }
      }
      if (action !== "finalize" && action !== "update") return { ok: false, error: "cellwork_requirements: action must be `finalize` or `update` (got " + JSON.stringify(action) + ")" }
      /** The document text the call carries, or the file's current text. */
      let text_: string | null = null
      /** The supplied content, when the caller passed one. */
      const content = argString(argv, "content")
      if (content.trim() !== "") text_ = content
      else {
        try {
          text_ = readRequirements(caller.workspace, state.cellId)
        } catch (error) {
          return { ok: false, error: "cellwork_requirements: the requirements document could not be read (" + (error instanceof Error ? error.message : String(error)) + ")" }
        }
      }
      if (text_ === null || text_.trim() === "") {
        return { ok: false, error: "cellwork_requirements: no document to validate — write `requirements.md` under " + requirementsPath(caller.workspace, state.cellId) + " or pass `content`" }
      }
      /** The section validation. */
      const validation = validateRequirementsText(text_)
      /** The absolute document path. */
      const path = requirementsPath(caller.workspace, state.cellId)
      /** The instant this decision is stamped with. */
      const now = new Date()
      if (!validation.ok) {
        appendJournal(caller.workspace, state.cellId, { event: "requirements-refused", action, missing: validation.missing }, now)
        return { ok: false, error: "cellwork_requirements: the document is INCOMPLETE — these sections are missing or empty: " + validation.missing.join(", ") + ". Ask the user, fill them, and call again.", missing: [...validation.missing], sections: validation.sections, requirementsPath: path }
      }
      if (action === "finalize") {
        // A finalize over an already-accepted revision is idempotent ONLY when the bytes match. A changed
        // document must go through `update`, because update is what moves the revision and marks a live
        // split stale — the planner cannot silently change scope under an activated split.
        if (state.requirementsRevision > 0) {
          /** The accepted document as it stands. */
          const accepted = ((): string => {
            try { return readRequirements(caller.workspace, state.cellId) ?? "" } catch { return "" }
          })()
          if (accepted === storedRequirementsText(text_)) {
            return { ok: true, action, revision: state.requirementsRevision, splitStale: state.splitStale, alreadyFinalized: true, sections: validation.sections, requirementsPath: path }
          }
          return { ok: false, error: "cellwork_requirements: revision " + String(state.requirementsRevision) + " is already accepted and the document CHANGED — use {action:\"update\"} to revise it (an accepted revision is never rewritten in place)" }
        }
        writeRequirements(caller.workspace, state.cellId, text_)
        /** The board the cell is actually working on (§7.1a). */
        const board = boardOf(caller.workspace, state)
        /** The requirements task this finalize closes, when the board still holds it open. */
        const closed = await completeCellTask(exec, board.teamId, (row) => String(row.kind ?? "") === "requirement" && String(row.owner ?? "") === PLANNER_MEMBER, "requirements revision 1 finalized")
        /** The record after the transition. */
        const next: CellState = { ...state, requirementsRevision: 1, phase: state.phase === "requirements" ? "split" : state.phase }
        transition(caller.workspace, next, { event: "requirements-finalize", revision: 1, sections: validation.sections.map((section) => section.key), closedTaskId: closed ?? null, boardTeamId: board.teamId, recordedTeamId: board.recordedTeamId, ...(board.note === undefined ? {} : { boardNote: board.note }) }, now)
        return { ok: true, action, revision: 1, splitStale: next.splitStale, alreadyFinalized: false, sections: validation.sections, requirementsPath: path, ...(closed === undefined ? {} : { closedTaskId: closed }), ...(board.note === undefined ? {} : { boardNote: board.note }) }
      }
      // UPDATE: a new revision, any accepted split is now stale, and the SAME split task is re-dispatched.
      writeRequirements(caller.workspace, state.cellId, text_)
      /** The new revision: one past the accepted one, or the first revision. */
      const revision = Math.max(1, state.requirementsRevision) + 1
      /** The board the cell is actually working on (§7.1a): the re-split ticket lives HERE, not on the stale id. */
      const board = boardOf(caller.workspace, state)
      /** The live board, read to find the splitter's task. */
      const record = recordOf(teams(), caller.workspace, board.teamId)
      // THE LOOKUP READS THE RECORDED BOARD ID FIRST (contract C11, defect D3): a staged ticket whose
      // owner was lost was invisible to the owner-only lookup, so a requirements bump neither marked the
      // split stale nor re-dispatched the SAME row. The owner match stays as the fallback.
      // A LIVE ROW WINS OVER THE RECORDED TERMINAL ONE (CR #3). After the first activation the recorded id
      // names the CLOSED original, while a previous update may have appended a replacement the splitter can
      // still claim. Preferring the closed row over that live replacement appended ANOTHER row on every
      // bump, and this board has no cancel verb — so the live row is the one this update re-dispatches.
      const splitTask = findSplitTicket(boardTasksOf(record), state.splitTaskId ?? "", true) ?? findSplitTicket(boardTasksOf(record), state.splitTaskId ?? "", false)
      /** The board id of that task, when one exists. */
      const splitTaskId = splitTask === undefined ? "" : String(splitTask.id ?? "")
      /** The status that task is in, so the caller can see whether the row is still dispatchable. */
      const splitTaskStatus = splitTask === undefined ? "" : String(splitTask.status ?? "")
      /** Whether the row can still be dispatched (a terminal row cannot be reopened on this board). */
      const redispatchable = splitTaskStatus === "pending" || splitTaskStatus === "claimed" || splitTaskStatus === "in_progress"
      // A TERMINAL SPLIT ROW CANNOT BE REOPENED, and after the first activation it always is one (the
      // activation closes it). The re-split path therefore APPENDS a replacement splitter row — same
      // owner, same cell role, the new revision in its subject — rather than duplicating the graph: the
      // splitter needs one open row to claim, exactly as it had on the first pass.
      /** The replacement row this update appended, when the original row was terminal. */
      let replacementSplitTaskId = ""
      if (!redispatchable && board.teamId !== "") {
        /** The append onto the LIVE team (spawns nobody; the splitter already exists). */
        const appended = await dsh.executeTool({
          name: "agent_teams_plan",
          arguments: {
            action: "create_task",
            task: {
              subject: "Re-split for requirements revision " + String(revision),
              description: "The requirements document moved to revision " + String(revision) + ". Re-read `<cell>/requirements.md` and `cellwork_status`, then submit ONE measured graph against revision " + String(revision) + " with `cellwork_split {action:\"submit\"}`. Only NEW or CHANGED work needs a task: the activation reuses the board row of every key it keeps, and marks what you drop cancelled.",
              kind: "work",
              owner: SPLITTER_MEMBER,
              blocked_by: [],
            },
          },
          agent: exec.agent,
        })
        if (appended.ok) {
          /** The appended row's board id, when the answer carried one. */
          const row = typeof appended.value === "object" && appended.value !== null ? appended.value as Record<string, unknown> : {}
          /** The minted task, when the answer carried it. */
          const task = typeof row.task === "object" && row.task !== null ? row.task as Record<string, unknown> : undefined
          replacementSplitTaskId = typeof task?.id === "string" ? task.id : ""
        }
      }
      // THE RECORD MUST NAME THE ROW THE NEXT UPDATE REUSES (CR #3): a replacement id is written back, so
      // a second bump finds the LIVE replacement instead of the closed original and appends nothing. An
      // update that found no row at all keeps whatever id the record already carried.
      /** The split ticket id the cell record carries after this update. */
      const recordedSplitTaskId = replacementSplitTaskId !== "" ? replacementSplitTaskId : (splitTaskId !== "" ? splitTaskId : (state.splitTaskId ?? ""))
      /** The record after the transition. */
      const next: CellState = { ...state, requirementsRevision: revision, splitTaskId: recordedSplitTaskId, splitStale: state.splitRevision !== null ? true : state.splitStale }
      transition(caller.workspace, next, { event: "requirements-update", revision, previousRevision: state.requirementsRevision, splitStale: next.splitStale, splitTaskId, splitTaskStatus, redispatchable, recordedSplitTaskId, boardTeamId: board.teamId, recordedTeamId: board.recordedTeamId, ...(board.note === undefined ? {} : { boardNote: board.note }), ...(replacementSplitTaskId === "" ? {} : { replacementSplitTaskId }) }, now)
      if (replacementSplitTaskId !== "") {
        appendJournal(caller.workspace, caller.cell.cellId, { event: "split-task-replaced", previousTaskId: splitTaskId, replacementTaskId: replacementSplitTaskId, revision }, now)
      }
      return {
        ok: true,
        action,
        revision,
        splitStale: next.splitStale,
        alreadyFinalized: false,
        sections: validation.sections,
        requirementsPath: path,
        splitTaskId,
        splitTaskStatus,
        redispatchable,
        replacementSplitTaskId,
        recordedSplitTaskId,
        ...(board.note === undefined ? {} : { boardNote: board.note }),
        ...(splitTaskId === "" ? { message: "no split task is on the board yet — the splitter will receive the whole graph when it is dispatched" } : redispatchable
          ? { message: "the SAME split task " + splitTaskId + " is re-dispatched with revision " + String(revision) + (next.splitStale ? " and the split marked STALE" : "") + " — dispatch it with `cellwork_dispatch`" }
          : { message: "split task " + splitTaskId + " is " + splitTaskStatus + " and this board has no reopen verb, so a replacement row " + (replacementSplitTaskId === "" ? "could NOT be appended (no live team to append to)" : replacementSplitTaskId) + " carries the re-split with revision " + String(revision) + " — dispatch it with `cellwork_dispatch`" }),
      }
    },
  }))

  // ── cellwork_recon ───────────────────────────────────────────────────────
  disposers.push(dsh.registerTool({
    name: "cellwork_recon",
    description: "PLANNER/SUBCAPTAIN only: raise READ-ONLY consults (label exactly `Explorer` or `Researcher`) through the `mpdConsults` service, so the roles row applies the read-only deny list to the child and places it one level below the caller as a LEAF (caller agent depth + 1 — `cellwork.depthMax` counts nested CELLS and never caps the child). ONE question (`{role, task}`, the legacy blocking form) returns its report; 1..16 questions (`{role, questions}`, the per-call bound is `cellwork.recon.maxQuestions`) run CONCURRENTLY and the call returns only when ALL of them are settled, one row per question. Every report is journaled in the cell; an absent `mpdConsults` service is refused by name, never replaced by an unsupervised spawn.",
    parameters: {
      type: "object",
      properties: {
        role: { type: "string", enum: ["Explorer", "Researcher"], description: "The read-only roster role; the label is applied verbatim so the roles row applies the read-only deny list." },
        task: { type: "string", description: "The ONE question the consult must answer (legacy blocking form; exactly one of `task`/`questions`)." },
        questions: { type: "array", items: { type: "string" }, description: "1..`cellwork.recon.maxQuestions` questions (default 16) settled CONCURRENTLY; the call returns when every one is settled (exactly one of `task`/`questions`)." },
      },
      required: ["role"],
      additionalProperties: false,
    },
    output: {
      schema: {
        type: "object",
        properties: {
          ok: { type: "boolean" },
          error: { type: "string" },
          path: { type: "string" },
          role: { type: "string" },
          label: { type: "string" },
          report: { type: "string" },
          stopReason: { oneOf: [{ type: "string" }, { type: "null" }] },
          personaInjected: { type: "boolean" },
          reports: {
            type: "array",
            items: {
              type: "object",
              properties: {
                question: { type: "string" },
                report: { type: "string" },
                stopReason: { oneOf: [{ type: "string" }, { type: "null" }] },
                interrupted: { type: "boolean" },
                handoff: { type: "string" },
              },
              required: ["question", "report", "stopReason"],
            },
          },
        },
        required: ["ok"],
      },
      render: (_args: unknown, value: unknown): unknown => {
        /** The result as a record. */
        const result = typeof value === "object" && value !== null ? value as Record<string, unknown> : {}
        if (result.ok === false) return text("cellwork_recon refused: " + String(result.error ?? "unknown refusal"))
        /** The batch rows, when the call asked a `questions` array. */
        const rows = Array.isArray(result.reports) ? result.reports as Array<Record<string, unknown>> : []
        if (rows.length > 0) {
          return text(String(result.label ?? "consult") + " — " + String(rows.length) + " report(s)" + (result.personaInjected === true ? ", persona injected" : ", NO persona readable") + ":\n\n" + rows.map((row, index) =>
            "[" + String(index + 1) + "] " + String(row.question ?? "") + "\n" + String(row.report ?? "") + (row.stopReason === null || row.stopReason === undefined ? "" : "\n(stopReason: " + String(row.stopReason) + ")" + (row.handoff === undefined ? "" : "\n(handoff: " + String(row.handoff) + ")"))).join("\n\n"))
        }
        return text(String(result.label ?? "consult") + " report (" + String(result.report ?? "").length + " chars" + (result.personaInjected === true ? ", persona injected" : ", NO persona readable") + "):\n\n" + String(result.report ?? ""))
      },
    },
    execute: async (args: unknown, exec: DshToolExec): Promise<FlowResult> => {
      /** The argument record. */
      const argv = readArgs(args)
      /** The caller's context. */
      const caller = callerFor(exec)
      if (caller.refusal !== null) return { ok: false, error: refusalText(caller.refusal), path: caller.refusal.path }
      /** The no-live-cell refusal, or undefined when a cell is running. */
      const noCell = noLiveCellRefusal(caller, "cellwork_recon")
      if (noCell !== undefined) return { ok: false, error: noCell }
      /** The running cell; the refusal above already proved one exists. */
      const cell = caller.cell
      if (cell === null) return { ok: false, error: "cellwork_recon: no active cell in this workspace" }
      /** The consult outcome. */
      const result = await runRecon({
        consults: consults(),
        exec,
        workspace: caller.workspace,
        cell,
        caller: { member: caller.member, mode: caller.seat?.mode ?? "member" },
        personaFor,
        now: new Date(),
        // READ PER CALL (§6.2): the bound and the budget this call asks the ONE supervisor for.
        maxQuestions: knobOf("reconMaxQuestions"),
        consultMax: knobOf("consultMax"),
      }, {
        role: argString(argv, "role"),
        ...(typeof argv.task === "string" ? { task: argv.task } : {}),
        ...(Array.isArray(argv.questions) ? { questions: argv.questions as string[] } : {}),
      })
      return result.ok ? { ...result } : { ok: false, error: result.error }
    },
  }))

  // ── cellwork_delegate ────────────────────────────────────────────────────
  // BACKGROUND, BATCH delegation for a cell SEAT (never the captain): 1..32 consults start in ONE pass and
  // the call returns their ids immediately, so the children overlap instead of serialising behind this
  // seat. Roles may be WRITERS here, exactly as the top-level captain's `mpd_role_spawn_async` allows; the
  // board-scale route stays `cellwork_split` + `cellwork_activate` (contract §4.1).
  disposers.push(dsh.registerTool({
    name: "cellwork_delegate",
    description: "PLANNER / SUBCAPTAIN / recorded MEMBER only (the cell captain is refused): start 1..32 BACKGROUND consults in ONE call and return their `consultId`s immediately, before any child settles. Roles are ANY roster role — writers included — and are canonicalised by the roles row (`deep worker` = `Deep-Worker` = `Deep Worker`), so the answer echoes the canonical name. ALL-OR-NOTHING: an unknown role, an empty field or more than `cellwork.delegate.maxTasks` (default 32) tasks refuses the whole call and starts nothing. Over-cap work QUEUES on the ONE consult supervisor's budget (`cellwork.consultMax`, default 32; an explicit `MPD_DSH_CONSULT_MAX` still wins) and is never refused. Collect with `cellwork_consult`; for read-only reconnaissance prefer `cellwork_recon`.",
    parameters: {
      type: "object",
      properties: {
        tasks: {
          type: "array",
          description: "1..`cellwork.delegate.maxTasks` tasks (default 32) started in ONE pass; every one must validate or the call starts nothing.",
          items: {
            type: "object",
            properties: {
              role: { type: "string", description: "A roster role NAME (any case, space, hyphen or underscore spelling; see `mpd_roles_list`)." },
              task: { type: "string", description: "The assignment / question this consult answers." },
              context: { type: "string", description: "Optional extra prompt block (why the consult exists)." },
            },
            required: ["role", "task"],
            additionalProperties: false,
          },
        },
      },
      required: ["tasks"],
      additionalProperties: false,
    },
    output: {
      schema: {
        type: "object",
        properties: {
          ok: { type: "boolean" },
          error: { type: "string" },
          started: { type: "integer" },
          consults: {
            type: "array",
            items: {
              type: "object",
              properties: {
                consultId: { type: "string" },
                role: { type: "string" },
                startedAt: { type: "number" },
              },
              required: ["consultId", "role", "startedAt"],
            },
          },
        },
        required: ["ok"],
      },
      render: (_args: unknown, value: unknown): unknown => {
        /** The result as a record. */
        const result = typeof value === "object" && value !== null ? value as Record<string, unknown> : {}
        if (result.ok === false) return text("cellwork_delegate refused: " + String(result.error ?? "unknown refusal"))
        /** The started rows. */
        const rows = Array.isArray(result.consults) ? result.consults as Array<Record<string, unknown>> : []
        return text("started " + String(result.started ?? rows.length) + " background consult(s) — collect them with `cellwork_consult`:\n" + rows.map((row) => "- " + String(row.role ?? "") + " · " + String(row.consultId ?? "")).join("\n"))
      },
    },
    execute: async (args: unknown, exec: DshToolExec): Promise<FlowResult> => {
      /** The argument record. */
      const argv = readArgs(args)
      /** The caller's context. */
      const caller = callerFor(exec)
      if (caller.refusal !== null) return { ok: false, error: refusalText(caller.refusal), path: caller.refusal.path }
      /** The no-live-cell refusal, or undefined when a cell is running. */
      const noCell = noLiveCellRefusal(caller, "cellwork_delegate")
      if (noCell !== undefined) return { ok: false, error: noCell }
      // DEFENCE IN DEPTH: the guard refuses a captain/verifier/checkpointed session first, and this
      // predicate repeats the SAME sentence so a bypassed guard still cannot delegate.
      /** The seat refusal, or undefined when this seat may delegate. */
      const seatRefusal = consultSeatRefusal("cellwork_delegate", caller.seat)
      if (seatRefusal !== undefined) return { ok: false, error: seatRefusal }
      /** The running cell; the refusals above already proved one exists. */
      const cell = caller.cell
      if (cell === null) return { ok: false, error: "cellwork_delegate: no active cell in this workspace" }
      /** The delegation outcome. */
      const result = await startDelegation({
        service: consults,
        rosterNames,
        cellId: cell.cellId,
        workspace: caller.workspace,
        exec,
        now: new Date(),
        book: consultBook,
        // THE PLANE ADDRESS (consult DAG, contract §3): a cell that never approved a team records
        // nothing, and the writer journals that instead of failing the call.
        teamId: cell.teamId,
        teamActions,
        // READ PER CALL (§6.2): the per-call bound and the budget this delegation asks the ONE supervisor.
        maxTasks: knobOf("delegateMaxTasks"),
        consultMax: knobOf("consultMax"),
      }, argv.tasks)
      return result.ok ? { ...result } : { ok: false, error: result.error }
    },
  }))

  // ── cellwork_consult ─────────────────────────────────────────────────────
  // The settle/inspect surface for the consults ONE cell started. Ownership is per cell id: an id this cell
  // never started is refused with a sentence that teaches the two other channels, never "not found" alone.
  disposers.push(dsh.registerTool({
    name: "cellwork_consult",
    description: "PLANNER / SUBCAPTAIN / recorded MEMBER only (the cell captain is refused): list, wait for, collect or cancel the consults THIS cell started through `cellwork_delegate`. `list` answers only this cell's ids that the consult supervisor still knows (a direct `mpd_role_consult {action:\"collect\"}` releases one, and a restart drops every handle); `wait` clamps `timeoutMs` to 1..60000 (default 30000) and a timed-out wait answers `state:\"running\"` rather than throwing; `collect` returns the settled report and RELEASES the record; `cancel` interrupts that child and journals it. An id this cell did not start is refused, not guessed.",
    parameters: {
      type: "object",
      properties: {
        action: { type: "string", enum: [...CONSULT_ACTIONS], description: "list | wait | collect | cancel." },
        consultId: { type: "string", description: "The id `cellwork_delegate` returned; required for every action except `list`." },
        timeoutMs: { type: "number", description: "The `wait` bound in ms, clamped to 1.." + String(CONSULT_WAIT_MAX_MS) + "; default " + String(CONSULT_WAIT_DEFAULT_MS) + "." },
      },
      required: ["action"],
      additionalProperties: false,
    },
    output: {
      schema: {
        type: "object",
        properties: {
          ok: { type: "boolean" },
          error: { type: "string" },
          action: { type: "string" },
          consults: {
            type: "array",
            items: {
              type: "object",
              properties: {
                consultId: { type: "string" },
                role: { type: "string" },
                state: { type: "string" },
                startedAt: { type: "number" },
                elapsedMs: { type: "number" },
                hostRetries: { type: "number", description: "How many times the HOST refused a live slot before this consult started (§6.1); absent when it was admitted first time." },
                question: { type: "string" },
              },
            },
          },
          consultId: { type: "string" },
          role: { type: "string" },
          state: { type: "string" },
          startedAt: { type: "number" },
          elapsedMs: { type: "number" },
          handoff: { type: "string" },
          errorDetail: { type: "string", description: "The consult's OWN failure text (a raised child that never reported), distinct from a refusal." },
          report: {
            type: "object",
            properties: {
              role: { type: "string" },
              status: { type: "string" },
              summary: { type: "string" },
              recommendation: { type: "string" },
              details: { type: "string" },
              evidence: { type: "array", items: { type: "string" } },
              stopReason: { oneOf: [{ type: "string" }, { type: "null" }] },
              consultId: { type: "string" },
              elapsedMs: { type: "number" },
              handoff: { type: "string" },
              lastActivity: { type: "string" },
            },
          },
        },
        required: ["ok"],
      },
      render: (_args: unknown, value: unknown): unknown => {
        /** The result as a record. */
        const result = typeof value === "object" && value !== null ? value as Record<string, unknown> : {}
        if (result.ok === false) return text("cellwork_consult refused: " + String(result.error ?? "unknown refusal"))
        /** The listed rows, when the action was `list`. */
        const rows = Array.isArray(result.consults) ? result.consults as Array<Record<string, unknown>> : []
        if (result.action === "list") {
          return text(rows.length === 0
            ? "this cell has no consult the supervisor still knows — start work with `cellwork_delegate`"
            : "this cell's consults (" + String(rows.length) + "):\n" + rows.map((row) => "- " + String(row.role ?? "") + " · " + String(row.consultId ?? "") + " · " + String(row.state ?? "") + " · " + String(row.elapsedMs ?? 0) + " ms" + (typeof row.hostRetries === "number" ? " · hostRetries " + String(row.hostRetries) : "") + " · " + String(row.question ?? "")).join("\n"))
        }
        /** The report a `collect` released. */
        const report = typeof result.report === "object" && result.report !== null ? result.report as Record<string, unknown> : undefined
        if (report === undefined) return text(String(result.action ?? "consult") + " · " + String(result.role ?? "") + " · " + String(result.state ?? "running") + " · " + String(result.elapsedMs ?? 0) + " ms" + (typeof result.errorDetail === "string" ? "\n" + result.errorDetail : ""))
        return text(String(result.action ?? "collect") + " · " + String(report.role ?? "") + " · " + String(report.status ?? "") + " · " + String(report.elapsedMs ?? 0) + " ms" + (report.summary === undefined || report.summary === "" ? "" : "\n\n" + String(report.summary)) + (Array.isArray(report.evidence) && report.evidence.length > 0 ? "\n\nevidence:\n" + report.evidence.map((entry) => "- " + String(entry)).join("\n") : ""))
      },
    },
    execute: async (args: unknown, exec: DshToolExec): Promise<FlowResult> => {
      /** The argument record. */
      const argv = readArgs(args)
      /** The caller's context. */
      const caller = callerFor(exec)
      if (caller.refusal !== null) return { ok: false, error: refusalText(caller.refusal), path: caller.refusal.path }
      /** The no-live-cell refusal, or undefined when a cell is running. */
      const noCell = noLiveCellRefusal(caller, "cellwork_consult")
      if (noCell !== undefined) return { ok: false, error: noCell }
      /** The seat refusal, or undefined when this seat may inspect its consults. */
      const seatRefusal = consultSeatRefusal("cellwork_consult", caller.seat)
      if (seatRefusal !== undefined) return { ok: false, error: seatRefusal }
      /** The running cell; the refusals above already proved one exists. */
      const cell = caller.cell
      if (cell === null) return { ok: false, error: "cellwork_consult: no active cell in this workspace" }
      /** The action outcome. */
      const result = await runConsultAction({
        service: consults,
        rosterNames,
        cellId: cell.cellId,
        workspace: caller.workspace,
        exec,
        now: new Date(),
        book: consultBook,
        teamId: cell.teamId,
        teamActions,
      }, { action: argString(argv, "action"), consultId: argString(argv, "consultId"), timeoutMs: argv.timeoutMs })
      return result
    },
  }))

  // ── cellwork_split ───────────────────────────────────────────────────────
  disposers.push(dsh.registerTool({
    name: "cellwork_split",
    description: "The SPLITTER's tool (cell-splitter only) for `submit`; any cell seat may `show` the last verdict. `submit` MEASURES every task (declared input bytes → tokens, the model-read context window) and validates the graph (dependency answer, acyclicity, write-scope ordering, verifier ≠ writer, role existence), accepting or refusing with a per-task breakdown; a refused split may be resubmitted. NON-FATAL `warnings` are reported BESIDE the verdict and never change `accepted`: a `work`/`repair`/`integration` task that declares NO `writeScopes` freezes a contract allowing no path, so its writer would stop at the first edit — declare the scopes, or amend the contract with the captain BEFORE the first write.",
    parameters: {
      type: "object",
      properties: {
        action: { type: "string", enum: ["submit", "show"], description: "submit a graph, or show the last measured verdict." },
        revision: { type: "number", description: "submit: the requirements revision the graph targets; defaults to the accepted one." },
        tasks: {
          type: "array",
          items: {
            type: "object",
            properties: {
              key: { type: "string", description: "Stable task key; also the contract file name." },
              subject: { type: "string", description: "One-line title." },
              description: { type: "string", description: "The owner's acceptance text." },
              kind: { type: "string", enum: ["requirement", "work", "review", "repair", "integration"], description: "Chain kind; omitted means work." },
              ownerRole: { type: "string", description: "A roster role name or a cell role." },
              member: { type: "string", description: "The board member this task is raised for; omitted means the member IS the owner role. Several tasks may share one member; several members may share one role." },
              writeScopes: { type: "array", items: { type: "string" }, description: "Paths the task may write." },
              blockedBy: { type: "array", items: { type: "string" }, description: "Task keys that must close first; [] is an explicit root." },
              independent: { type: "boolean", description: "Explicit root, alternative to blockedBy: []." },
              inputs: { type: "array", items: { type: "string" }, description: "Workspace-relative paths the plugin MEASURES." },
              verify: { type: "boolean", description: "true when this task's work needs exactly one review task." },
            },
            required: ["key", "subject", "description", "ownerRole"],
            additionalProperties: false,
          },
        },
      },
      required: ["action"],
      additionalProperties: false,
    },
    output: {
      schema: {
        type: "object",
        properties: {
          ok: { type: "boolean" },
          error: { type: "string" },
          path: { type: "string" },
          action: { type: "string" },
          accepted: { type: "boolean" },
          revision: { type: "number" },
          findings: { type: "array", items: { type: "object" } },
          warnings: { type: "array", items: { type: "object" }, description: "NON-FATAL advisories, in two classes: `write-scopes-empty` (a `work`/`repair`/`integration` task with no write scope) and `seat-width-short` (an owner role whose ready-frontier width exceeds the board member names its tasks declare). They never change `accepted`." },
          roles: { type: "array", items: { type: "object" } },
          tasks: { type: "array", items: { type: "object" } },
          totals: { type: "object" },
          splitPath: { type: "string" },
          supersededRevision: { oneOf: [{ type: "number" }, { type: "null" }] },
          message: { type: "string" },
        },
        required: ["ok"],
      },
      render: (_args: unknown, value: unknown): unknown => {
        /** The result as a record. */
        const result = typeof value === "object" && value !== null ? value as Record<string, unknown> : {}
        if (result.ok === false) return text("cellwork_split refused: " + String(result.error ?? "unknown refusal"))
        /** The non-fatal advisories this verdict carries. */
        const warnings = Array.isArray(result.warnings) ? result.warnings as Array<Record<string, unknown>> : []
        /** The one line that makes the omissions visible; empty when there is nothing to say. */
        const warnLine = warnings.length === 0
          ? ""
          : ((): string => {
            /** The advisory classes this verdict carries — each class owns its OWN remedy. */
            const codes = new Set(warnings.map((warning) => String(warning.code ?? "")))
            /** Whether the missing-write-scope class is the ONLY class, which keeps today's exact sentence. */
            const onlyScopes = codes.size > 0 && [...codes].every((code) => code === "write-scopes-empty")
            /** The heading: the scope-specific one only when no other class is present. */
            const heading = onlyScopes ? "\nSCOPE WARNING(S)" : "\nSPLIT WARNING(S)"
            /** One remedy per class present, so a seat-width advisory never borrows the write-scope remedy. */
            const remedies: string[] = []
            if (codes.has("write-scopes-empty")) remedies.push("declare `writeScopes` in the next revision, or ask the captain for a scope extension BEFORE the first write")
            if (codes.has("seat-width-short")) remedies.push("declare more `member` names (`<role>-2`, `<role>-3`, …) in the next revision so each ready row runs on its own seat, or add dependency edges if those rows must not run together")
            if (remedies.length === 0) remedies.push("repair each advisory above in the next revision")
            return heading + " — non-fatal, the split stays accepted: " + warnings.map((warning) => String(warning.taskKey ?? "?") + ": " + String(warning.detail ?? warning.code ?? "")).join(" | ") + "\nRemedy: " + remedies.join("; ")
          })()
        if (typeof result.message === "string") return text(result.message + warnLine)
        return text("split revision " + String(result.revision ?? "?") + ": " + (result.accepted === true ? "ACCEPTED" : "REFUSED") + (result.accepted === true ? "" : " — the per-task breakdown is at " + String(result.splitPath ?? "?")) + warnLine + "\n" + JSON.stringify(result.totals ?? {}, null, 2))
      },
    },
    execute: async (args: unknown, exec: DshToolExec): Promise<FlowResult> => {
      /** The argument record. */
      const argv = readArgs(args)
      /** The requested action. */
      const action = argString(argv, "action")
      /** The caller's context. */
      const caller = callerFor(exec)
      if (caller.refusal !== null) return { ok: false, error: refusalText(caller.refusal), path: caller.refusal.path }
      if (caller.workspace === "" || caller.cell === null) return { ok: false, error: "cellwork_split: no active cell in this workspace" }
      /** The active cell's record. */
      const state = caller.cell
      if (state.phase === "stopped") return { ok: false, error: "cellwork_split: cell " + state.cellId + " is stopped and archived" }
      if (action === "show") {
        /** The latest stored verdict. */
        const latest = latestSplit(caller.workspace, state.cellId)
        if (latest === null) return { ok: false, error: "cellwork_split show: no split has been submitted for " + state.cellId + " yet" }
        /** The stored read, narrowed once so the union's branches stay apart. */
        const read = latest.read
        if (!read.ok) return { ok: false, error: "cellwork_split show: " + read.detail, path: read.path }
        /** The stored verdict. */
        const verdict = read.verdict
        return { ok: true, action, accepted: verdict.accepted, revision: verdict.revision, findings: verdict.findings, warnings: verdict.warnings, roles: verdict.roles, tasks: verdict.tasks, totals: verdict.totals, splitPath: splitPathFor(caller.workspace, verdict) }
      }
      if (action !== "submit") return { ok: false, error: "cellwork_split: action must be `submit` or `show` (got " + JSON.stringify(action) + ")" }
      if (caller.member !== SPLITTER_MEMBER) {
        return { ok: false, error: "cellwork_split submit is SPLITTER-ONLY: this session is " + JSON.stringify(caller.member === "" ? "not a cell member" : caller.member) + ". The split is requirement reasoning (clause 1) and belongs to cell-splitter, not the captain." }
      }
      if (state.requirementsRevision === 0) return { ok: false, error: "cellwork_split: the requirements document has not been FINALIZED yet (revision 0) — wait for the planner to close the interview and the captain to dispatch you" }
      /** The revision this submission targets. */
      const asked = typeof argv.revision === "number" ? argv.revision : state.requirementsRevision
      if (asked !== state.requirementsRevision) {
        return { ok: false, error: "cellwork_split: revision " + String(asked) + " does not match the accepted requirements revision " + String(state.requirementsRevision) + " — a split is judged against the document it targets; re-read `cellwork_status` and resubmit against revision " + String(state.requirementsRevision) }
      }
      /** The raw task list. */
      const rawTasks = Array.isArray(argv.tasks) ? argv.tasks : []
      if (rawTasks.length === 0) return { ok: false, error: "cellwork_split: `tasks` is empty — submit the graph the planner's requirements justify" }
      /** The roster names the graph is validated against. */
      const roster = rosterNames()
      if (roster.length === 0) return { ok: false, error: "cellwork_split: the roster service (`mpdRoles`) is absent or empty in this composition, so owner roles cannot be validated — mount the roles row and resubmit" }
      /** The normalised submission. */
      const submission: SplitSubmission = {
        revision: asked,
        tasks: rawTasks.map((entry): SplitTaskInput => {
          /** The row as a record. */
          const row = readArgs(entry)
          return {
            key: argString(row, "key"),
            subject: argString(row, "subject"),
            description: argString(row, "description"),
            ...(argString(row, "kind") === "" ? {} : { kind: argString(row, "kind") }),
            ownerRole: argString(row, "ownerRole"),
            // OMITTED WHEN ABSENT, never `member: ""` (contract C1): a declared-but-empty name is refused
            // as `member-invalid`, so an empty string here would refuse EVERY split.
            ...(argString(row, "member") === "" ? {} : { member: argString(row, "member") }),
            writeScopes: stringList(row.writeScopes),
            blockedBy: Array.isArray(row.blockedBy) ? stringList(row.blockedBy) : (row.independent === true ? [] : undefined),
            independent: row.independent === true,
            inputs: stringList(row.inputs),
            verify: row.verify === true,
          }
        }),
      }
      /** The measured verdict (already persisted to split/<revision>.json). */
      const verdict: SplitVerdict = await submitSplit({ workspace: caller.workspace, cellId: state.cellId, config, roster, window: windowFor, now: new Date() }, submission)
      /** The verdict path for the render/report, read from the verdict (a refusal may sit beside the canonical file). */
      const splitPath = splitPathFor(caller.workspace, verdict)
      if (verdict.accepted) {
        // THE SPLIT TASK STAYS OPEN (Amendment 5, arm a): it is the vehicle a requirements `update`
        // re-dispatches with the new revision, and it is closed by `cellwork_activate` once the work is
        // materialised. Closing it here would leave a re-split with no same-task row to reopen.
        /** The revision this one supersedes, when an accepted split already existed and differs. */
        const supersededRevision = state.splitRevision !== null && state.splitRevision !== verdict.revision ? state.splitRevision : null
        transition(caller.workspace, { ...state, splitRevision: verdict.revision, splitStale: false }, { event: "split-accepted", revision: verdict.revision, totals: verdict.totals, ...(supersededRevision === null ? {} : { supersededRevision }) }, new Date())
        if (supersededRevision !== null) {
          // The PREVIOUS accepted revision is superseded, recorded where a reader of the history finds it.
          appendJournal(caller.workspace, state.cellId, { event: "split-superseded", revision: supersededRevision, by: verdict.revision, activated: state.activatedRevision }, new Date())
        }
        return { ok: true, action, accepted: true, revision: verdict.revision, findings: verdict.findings, warnings: verdict.warnings, roles: verdict.roles, tasks: verdict.tasks, totals: verdict.totals, splitPath, supersededRevision, message: "split revision " + String(verdict.revision) + " ACCEPTED" + (supersededRevision === null ? "" : " (revision " + String(supersededRevision) + " is superseded)") + " — the captain may call `cellwork_activate`" }
      }
      // THE FINDINGS TRAVEL ON THE ROW (contract C9): a bare count cannot tell a reader what to fix. The
      // refusal itself also lands at `split/<revision>.refused.json`, BESIDE the accepted record (never on
      // top of it), so nothing is overwritten by a later accepted resubmission — and this journal row is
      // the ORDERED half of that record: which refusal came before which accepted verdict.
      appendJournal(caller.workspace, state.cellId, { event: "split-refused", revision: verdict.revision, findings: verdict.findings.map((finding) => ({ code: finding.code, taskKey: finding.taskKey, detail: finding.detail })), warnings: verdict.warnings.map((warning) => ({ code: warning.code, taskKey: warning.taskKey })), refused: verdict.totals.refusedCount }, new Date())
      return { ok: true, action, accepted: false, revision: verdict.revision, findings: verdict.findings, warnings: verdict.warnings, roles: verdict.roles, tasks: verdict.tasks, totals: verdict.totals, splitPath }
    },
  }))

  // ── cellwork_activate ────────────────────────────────────────────────────
  disposers.push(dsh.registerTool({
    name: "cellwork_activate",
    description: "CAPTAIN only: materialise an ACCEPTED split on the LIVE team record. Requires an accepted split of the CURRENT requirements revision (a stale split is refused unless its revision is passed explicitly). Writes one frozen contract per NEW code task, raises ONE member per distinct `member` (its owner role routes it, persona TEXT in the prompt), appends each NEW task owned by that member with reviews blocked by their work task, opens a verify loop for EVERY code task that has none yet BEFORE dispatch (a kept task whose frozen contract already names a loop is left untouched), then dispatches owner-only. A failed pass is checkpointed and the SAME accepted revision resumes it; a newer accepted revision supersedes an older in-flight one (revisions never move backwards). A NEWER revision APPENDS to the same team: kept work reuses its board row, added work is appended, dropped work is marked `cancelled` and never deleted. On a re-split the result carries a `notice` stating how many tasks were kept, that their FROZEN contracts are NOT rewritten (a scope expansion needs a manual re-freeze plus a new verify loop), that this activation dispatched owner-only, and the one stage-4 exception where a kept contract IS rebuilt with its loop id. It never re-creates the team.",
    parameters: {
      type: "object",
      properties: {
        revision: { type: "number", description: "The accepted split revision to activate when the requirements moved on (explicitly acknowledges staleness)." },
      },
      additionalProperties: false,
    },
    output: {
      schema: {
        type: "object",
        properties: {
          ok: { type: "boolean" },
          error: { type: "string" },
          path: { type: "string" },
          cellId: { type: "string" },
          mode: { type: "string", description: "`initial` for the first materialisation, `resplit` when a newer revision appended to the same team." },
          revision: { type: "number" },
          contracts: { type: "array", items: { type: "string" } },
          membersRaised: { type: "array", items: { type: "string" } },
          reused: { type: "array", items: { type: "string" }, description: "Board names reused from the cell record or the live roster instead of raised." },
          tasks: { type: "array", items: { type: "object" } },
          kept: { type: "array", items: { type: "string" }, description: "Split keys whose live board row was reused (never duplicated)." },
          cancelled: { type: "array", items: { type: "object" }, description: "Work this revision dropped: `{key, boardId}`, marked cancelled on the cell record and never deleted." },
          loops: { type: "array", items: { type: "object" } },
          dispatch: { type: "object" },
          notice: { type: "string", description: "Present on a re-split: how many tasks were kept, that their frozen contracts are NOT rewritten, what a scope expansion therefore needs, that this activation dispatched owner-only, and the stage-4 rebuild exception." },
          boardNote: { type: "string", description: "Present when a re-split ran on the RECORDED team id because no resolver evidence verified it (`unverified`): names the recorded id, says the resolution is unverified, and carries the resolver's own note. It is a warning, not a refusal — the old cell still runs; do NOT start a new cell." },
        },
        required: ["ok"],
      },
      render: (_args: unknown, value: unknown): unknown => {
        /** The result as a record. */
        const result = typeof value === "object" && value !== null ? value as Record<string, unknown> : {}
        if (result.ok === false) return text("cellwork_activate refused: " + String(result.error ?? "unknown refusal"))
        /** The dispatch block. */
        const dispatch = typeof result.dispatch === "object" && result.dispatch !== null ? result.dispatch as Record<string, unknown> : {}
        /** The pairs actually delivered. */
        const pairs = Array.isArray(dispatch.pairs) ? dispatch.pairs as Array<Record<string, unknown>> : []
        /** The tasks left out. */
        const skipped = Array.isArray(dispatch.skipped) ? dispatch.skipped as Array<Record<string, unknown>> : []
        return text("cell activated on split revision " + String(result.revision ?? "?") + (result.mode === "resplit" ? " (re-split: " + String(Array.isArray(result.kept) ? result.kept.length : 0) + " kept, " + String(Array.isArray(result.cancelled) ? result.cancelled.length : 0) + " cancelled)" : "") + ": " + String(Array.isArray(result.tasks) ? result.tasks.length : 0) + " task(s), " + String(Array.isArray(result.loops) ? result.loops.length : 0) + " verify loop(s), " + pairs.length + " dispatched" + (skipped.length === 0 ? "" : ", " + skipped.length + " reported: " + skipped.map((row) => String(row.subject ?? row.taskId) + ": " + String(row.reason)).join("; ")) + (typeof result.notice === "string" ? "\nNOTICE: " + result.notice : "") + (typeof result.boardNote === "string" ? "\nBOARD: " + result.boardNote : ""))
      },
    },
    execute: async (args: unknown, exec: DshToolExec): Promise<FlowResult> => {
      /** The argument record. */
      const argv = readArgs(args)
      /** The caller's context. */
      const caller = callerFor(exec)
      if (caller.refusal !== null) return { ok: false, error: refusalText(caller.refusal), path: caller.refusal.path }
      if (caller.workspace === "" || caller.cell === null) return { ok: false, error: "cellwork_activate: no active cell in this workspace" }
      /** The active cell's record. */
      const state = caller.cell
      // THE PRODUCER MUST BE A LIVE SESSION (contract A4): the verify loops are opened under the caller's
      // OWN agent, so a dispatch carrying no live caller refuses BEFORE any write.
      if (sessionIdOf(exec.agent) === "") {
        return { ok: false, error: "cellwork_activate: this dispatch carries no LIVE caller agent (no session id), so the verify loops cannot be opened under a real session — nothing was materialised. Call this tool from a live agent session; a detached or synthetic handle is not accepted." }
      }
      if (caller.sessionId === "" || caller.sessionId !== state.captainSessionId) return { ok: false, error: "cellwork_activate is CAPTAIN-ONLY: the captain of " + state.cellId + " is session " + state.captainSessionId + ", which is not this caller" }
      if (state.phase === "stopped") return { ok: false, error: "cellwork_activate: cell " + state.cellId + " is stopped and archived" }
      if (state.teamId === "") return { ok: false, error: "cellwork_activate: no planning team is recorded on " + state.cellId + " — run `cellwork_start` first" }
      /** The accepted split revision, or the refusal when nothing was accepted. */
      const acceptedRevision = state.splitRevision
      if (acceptedRevision === null) return { ok: false, error: "cellwork_activate: no split has been ACCEPTED for this cell — the splitter must submit one first" }
      /** The revision the caller explicitly acknowledges, when one was passed. */
      const explicit = typeof argv.revision === "number" ? argv.revision : undefined
      /** Whether the accepted split no longer matches the requirements document. */
      const movedOn = state.splitStale || acceptedRevision !== state.requirementsRevision
      if (movedOn && explicit !== acceptedRevision) {
        return { ok: false, error: "cellwork_activate: split revision " + String(acceptedRevision) + " is STALE (requirements revision " + String(state.requirementsRevision) + (state.splitStale ? ", marked stale by an update" : "") + ") — the splitter must re-submit against the current revision; to activate the stale revision deliberately, pass {revision:" + String(acceptedRevision) + "}" }
      }
      if (state.activatedRevision !== null) {
        // A SECOND ACTIVATION IS THE RE-SPLIT PATH, and it is only ever FORWARD: the same revision is
        // already on the board (nothing to append), and an earlier one has been superseded.
        if (acceptedRevision === state.activatedRevision) {
          return { ok: false, error: "cellwork_activate: split revision " + String(state.activatedRevision) + " is already materialised on team " + state.teamId + " — nothing would be added. A re-split is a requirements `update` (which bumps the revision and marks the split stale), a NEW accepted split revision, then this call again" }
        }
        if (acceptedRevision < state.activatedRevision) {
          return { ok: false, error: "cellwork_activate: split revision " + String(acceptedRevision) + " is OLDER than the materialised revision " + String(state.activatedRevision) + " — revisions only move forward; accept a newer split instead" }
        }
      }
      // A PARTIAL ACTIVATION IS RESUMABLE WITH THE SAME REVISION (contract A3), and a STRICTLY NEWER
      // accepted revision SUPERSEDES the failed older one (contract F2) — only a LOWER revision is
      // refused, because revisions never move backwards.
      if (state.activationInFlight !== null && state.activationInFlight !== undefined && acceptedRevision < state.activationInFlight) {
        return { ok: false, error: "cellwork_activate: split revision " + String(acceptedRevision) + " is OLDER than the in-flight revision " + String(state.activationInFlight) + " — revisions only move forward; accept a newer split instead" }
      }
      // THE SUPERSESSION IS JOURNALED BY NAME: the older partial is abandoned, and the newer split's
      // delta reconciles its recorded rows here (kept ids reused, dropped keys cancelled).
      if (state.activationInFlight !== null && state.activationInFlight !== undefined && state.activationInFlight !== acceptedRevision) {
        appendJournal(caller.workspace, state.cellId, { event: "activation-in-flight-superseded", previous: state.activationInFlight, by: acceptedRevision, reason: "the accepted split moved on; the older partial is abandoned and its recorded rows are reconciled by this materialisation" }, new Date())
      }
      /** The stored verdict of the revision being activated (not "the latest": a stale one may be activated on purpose). */
      const stored = readSplit(caller.workspace, state.cellId, acceptedRevision)
      if (!stored.ok) return { ok: false, error: "cellwork_activate: " + stored.detail, path: stored.path }
      if (!stored.verdict.accepted) return { ok: false, error: "cellwork_activate: revision " + String(acceptedRevision) + " was REFUSED by the measured verdict — the splitter must fix the findings and resubmit" }
      /**
       * The ONE instant of this activation pass.
       *
       * Every row the pass writes — each progress row and the final `cell-activation-partial` — carries
       * it, so the journal is monotonic within a pass (contract C8/D7: the final `activate` row used to
       * carry a timestamp EARLIER than the checkpoint rows above it).
       */
      const activatedAt = new Date()
      /**
       * Persist one partial activation on the cell record (contract A2).
       *
       * The phase STAYS `split` and `activatedRevision` stays null: a partial pass must never look like a
       * materialised revision. `activationInFlight` is the one marker a retry may resume from.
       *
       * @param partial - the artifacts created so far.
       * @param error - the failure sentence, on the final write for a failed pass.
       */
      const persistPartial = (partial: ActivatePartial, error?: string): void => {
        // THE MINT IS PERSISTED WITH THE PARTIAL (blind review H1): the cell record moves to the execution
        // team the failure created and remembers the id in its own field, so `resplit` and the resolver
        // both see the mint on the retry instead of the ended planning team. `planningTeamId` keeps the
        // staging id WITHOUT overwriting one an earlier activation already preserved.
        /** The mint fields this checkpoint adds, or an empty object when the pass never minted. */
        const mintRecord = partial.mintedTeamId === undefined
          ? {}
          : {
            mintedTeamId: partial.mintedTeamId,
            teamId: partial.mintedTeamId,
            planningTeamId: state.planningTeamId === "" ? state.teamId : state.planningTeamId,
          }
        /** The record after the partial checkpoint. */
        const next: CellState = {
          ...state,
          activationInFlight: acceptedRevision,
          members: { ...state.members, ...partial.members },
          activatedTasks: { ...state.activatedTasks, ...partial.boardIds },
          activatedLoops: { ...(state.activatedLoops ?? {}), ...partial.loopIds },
          ...mintRecord,
        }
        transition(caller.workspace, next, {
          event: "cell-activation-partial",
          revision: acceptedRevision,
          members: Object.keys(partial.members),
          tasks: partial.boardIds,
          loops: partial.loopIds,
          contracts: Object.values(partial.contracts),
          // A FAILED PASS JOURNALS ITS MINT TOO (blind review H1): success is not the only moment the id
          // matters, and the trigger keeps "ended" distinguishable from "absent" (M2).
          ...(partial.mintedTeamId === undefined ? {} : { mintedTeamId: partial.mintedTeamId, minted: partial.minted === true, ...(partial.mintTrigger === undefined ? {} : { mintTrigger: partial.mintTrigger }) }),
          ...(error === undefined ? {} : { error }),
        }, activatedAt)
      }
      /** The materialisation. */
      const activated: ActivateResult = await materializeSplit({
        dsh: dsh as unknown as Parameters<typeof materializeSplit>[0]["dsh"],
        workspace: caller.workspace,
        cell: state,
        config,
        captainAgent: exec.agent,
        split: stored.verdict,
        personaFor,
        // §7.1: the board resolution sees the captain's LIVE team, and seat growth gets canonical roles.
        teams,
        rosterRoles: rosterNames,
        // BOUND TO THE CALLER'S WORKSPACE, resolved from THIS dispatch's exec: `dsh.workspaceRoot()`
        // without it falls back to `DSH_WORKSPACE_ROOT`/`process.cwd()`, and a host serving a session
        // whose workspace differs from the process cwd would read another tree's board (or none at all)
        // for the dispatch pass and for closing the open splitter row.
        recordFor: (teamId: string) => recordOf(teams(), caller.workspace, teamId),
        // THE PLANE'S WRITE SEAM: it pairs the materialised board and closes the rows this revision dropped.
        teamActions,
        // ONE compact row per artifact (contract C8): the accumulated state is journalled ONCE, below,
        // when the pass fails — never once per artifact (defect D7).
        progress: (step: ActivateProgress): void => {
          appendJournal(caller.workspace, state.cellId, { event: "cell-activation-progress", revision: acceptedRevision, ...step }, activatedAt)
        },
        now: activatedAt,
      })
      if (!activated.ok) {
        // THE FAILURE IS ITSELF A RESUMABLE STATE: persist the FINAL partial (the whole-state snapshot
        // exists exactly once, here) together with the sentence that stopped the pass. A minted execution
        // team travels with it (blind review H1) — in the record, in the journal and in this reply.
        if (activated.partial !== undefined) persistPartial(activated.partial, activated.error)
        return { ok: false, error: activated.error, ...(activated.partial?.mintedTeamId === undefined ? {} : { mintedTeamId: activated.partial.mintedTeamId }) }
      }
      /** The cancellations this activation recorded, keyed by split key for the cell record. */
      const cancelledNow: Record<string, string> = {}
      for (const entry of activated.outcome.cancelled) cancelledNow[entry.key] = entry.boardId
      // THE LOOP TABLE IS MERGED, NEVER REPLACED: a re-split keeps the loops an earlier revision armed,
      // while this pass's (and a resumed pass's) ids are recorded by split key.
      /** The verify-loop ids the cell records after this activation. */
      const loopTable: Record<string, string> = { ...(state.activatedLoops ?? {}) }
      for (const loop of activated.outcome.loops) loopTable[loop.taskKey] = loop.loopId
      /** The record after activation: the raised members, the live board mapping and the executing phase. */
      const next: CellState = {
        ...state,
        // §7.1: the record takes the EXECUTION board id, preserving the staging id beside it.
        ...(activated.outcome.teamId === undefined ? {} : { teamId: activated.outcome.teamId }),
        // THE STAGING ID IS WRITTEN ONCE (CodeRabbit #108): a RE-SPLIT's outcome reports the id this pass
        // STARTED from, which on a legacy cell is not necessarily the id the record preserved for staging —
        // overwriting it would lose the original. Only a record that carries NO staging id learns one here.
        ...(activated.outcome.planningTeamId === undefined || state.planningTeamId !== "" ? {} : { planningTeamId: activated.outcome.planningTeamId }),
        phase: "executing",
        activatedRevision: acceptedRevision,
        activationInFlight: null,
        // THE MINT IS NO LONGER IN FLIGHT: `teamId` now names the execution board for good, and keeping
        // the marker would pin every later resolution to an id that a re-split no longer needs (H1).
        mintedTeamId: "",
        activatedTasks: { ...activated.outcome.boardIds },
        activatedLoops: loopTable,
        cancelledTasks: { ...state.cancelledTasks, ...cancelledNow },
        splitStale: false,
        // THE SPLIT TICKET'S ID IS KEPT ON THE RECORD (contract C11): the activation closes the row it
        // resolved by that id, and every later lookup reads it FIRST instead of trusting an owner spelling.
        splitTaskId: (activated.outcome.splitTaskId ?? "") === "" ? (state.splitTaskId ?? "") : String(activated.outcome.splitTaskId),
        members: { ...state.members, ...activated.outcome.members },
      }
      transition(caller.workspace, next, { event: "cell-activation", mode: activated.outcome.mode, revision: acceptedRevision, tasks: activated.outcome.tasks.length, kept: activated.outcome.kept.length, cancelled: activated.outcome.cancelled.length, loops: activated.outcome.loops.length, reused: activated.outcome.reused, ...(activated.outcome.splitTaskId === undefined ? {} : { splitTaskId: activated.outcome.splitTaskId }), ...(activated.outcome.mintedTeamId === undefined ? {} : { mintedTeamId: activated.outcome.mintedTeamId, ...(activated.outcome.mintTrigger === undefined ? {} : { mintTrigger: activated.outcome.mintTrigger }) }) }, activatedAt)
      return {
        ok: true,
        cellId: state.cellId,
        mode: activated.outcome.mode,
        revision: acceptedRevision,
        contracts: activated.outcome.contracts,
        membersRaised: Object.keys(activated.outcome.members),
        reused: activated.outcome.reused,
        tasks: activated.outcome.tasks,
        kept: activated.outcome.kept,
        cancelled: activated.outcome.cancelled,
        loops: activated.outcome.loops,
        dispatch: activated.outcome.dispatch,
        ...(activated.outcome.notice === undefined ? {} : { notice: activated.outcome.notice }),
        ...(activated.outcome.boardNote === undefined ? {} : { boardNote: activated.outcome.boardNote }),
        // THE MINT IS PART OF THE ANSWER (blind review M2): a captain can tell a fresh execution team
        // from an append to a live board without reading the journal.
        ...(activated.outcome.mintedTeamId === undefined ? {} : { mintedTeamId: activated.outcome.mintedTeamId, ...(activated.outcome.mintTrigger === undefined ? {} : { mintTrigger: activated.outcome.mintTrigger }) }),
      }
    },
  }))

  return disposers
}

/**
 * One harness content block holding text.
 *
 * @param value - the text.
 * @returns the content blocks array.
 */
function text(value: string): Array<{ type: "text"; text: string }> {
  return [{ type: "text", text: value }]
}
