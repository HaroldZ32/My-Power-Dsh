### probeAstGrep source
export function probeAstGrep(binary) {
  try {
    const out = execFileSync(binary, ["--version"], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
      timeout: 20_000,
    })
    return String(out).toLowerCase().includes("ast-grep")
  } catch {
    return false
  }
}
