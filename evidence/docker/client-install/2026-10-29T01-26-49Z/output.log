----- STEP 01b-npm-registry (exit=0, 3s) -----
$ node -e    const registry = process.argv[1]   const probeUrl = process.argv[2]   const mirror = process.argv[3]   const label = process.argv[4]   const out = process.argv[5]   const tarballPath = process.argv[6]   const knob = process.argv[7]   const fs = await import("node:fs")   const probe = async (target) => {     const started = Date.now()     const controller = new AbortController()     const timer = setTimeout(() => controller.abort(), 20000)     try {       const response = await fetch(target, { signal: controller.signal })       await response.text()       clearTimeout(timer)       return { ok: response.status === 200, ms: Date.now() - started, status: "http=" + response.status }     } catch (error) {       clearTimeout(timer)       return { ok: false, ms: Date.now() - started, status: String(error).slice(0, 80) }     }   }   // ONE RANGED GET of the artifact the install will really fetch. `206` is the answer a registry that   // honours Range gives; `200` with bytes is accepted too, because some mirrors stream the whole object   // to a Range request — and in that case the reader below still takes a SINGLE chunk and cancels, so   // the cost stays a chunk rather than a tarball. A body of 0 bytes is a failure, never a pass.   const tarballProbe = async (base) => {     const started = Date.now()     const controller = new AbortController()     const timer = setTimeout(() => controller.abort(), 20000)     try {       const response = await fetch(base + tarballPath, { signal: controller.signal, headers: { Range: "bytes=0-1023" } })       const reader = response.body === null ? null : response.body.getReader()       const chunk = reader === null ? null : await reader.read()       if (reader !== null) await reader.cancel()       const bytes = chunk !== null && chunk.value !== undefined ? chunk.value.byteLength : 0       clearTimeout(timer)       return { ok: (response.status === 206 || response.status === 200) && bytes > 0, ms: Date.now() - started, status: "http=" + response.status + " bytes=" + bytes }     } catch (error) {       clearTimeout(timer)       return { ok: false, ms: Date.now() - started, status: String(error).slice(0, 80) }     }   }   const tarballRead = async (base) => {     if (knob === "") return { ok: true, skipped: true, reading: "skipped reason=no-registry-knob (the operator named no registry with MPD_E2E_NPM_REGISTRY, so the scoped METADATA probe above is the whole transport decision; the ranged GET is opt-in and this run paid no network for it)" }     const reading = await tarballProbe(base)     return { ok: reading.ok, skipped: false, reading: reading.status + " ms=" + reading.ms + (reading.ok ? "" : " FAILED") }   }   const settle = (chosen, route, detail, tarball) => {     fs.writeFileSync(out, chosen + "\n" + route + "\n" + tarball + "\n")     console.log("REGISTRY=" + chosen + " ROUTE=" + route + " " + detail)     console.log("TARBALL=" + tarball)   }   const first = await probe(probeUrl)   if (first.ok) {     const arm = await tarballRead(registry)     if (!arm.ok) {       // THE FALLBACK COMES BEFORE THE VERDICT (CodeRabbit finding on PR #42, 2026-10-15): this branch       // used to settle on the OFFICIAL/OPERATOR registry and exit 1, and the caller ignores that status       // with `|| true` — so every later install kept resolving through the very registry whose tarball       // blackholed. Metadata answering proves NOTHING about tarballs, so the MIRROR is probed for BOTH       // before the probe settles: when its metadata AND its ranged GET both answer, the install travels       // on the mirror; when the mirror fails too, the failure behaviour below is unchanged.       const fallback = await probe(mirror + "/@deepseek-ai%2fdsh")       if (fallback.ok) {         const mirrorArm = await tarballRead(mirror)         if (mirrorArm.ok) {           settle(mirror, "mirror-fallback-after-tarball-blackhole", "officialProbe=" + first.status + " officialTarball=" + arm.reading + " mirrorMs=" + fallback.ms + " mirrorTarball=" + mirrorArm.reading, mirrorArm.reading + " (the " + label + " registry answered METADATA while its TARBALL blackholed, so the install travels on the fallback mirror instead of stalling)")           process.exit(0)         }       }       settle(registry, label + "-tarball-blackholed", "probeMs=" + first.ms + " tarball=" + arm.reading, arm.reading + " (the METADATA endpoint answered and the TARBALL did not: a registry in this state stalls the install, so the probe FAILS here instead)")       process.exit(1)     }     settle(registry, label + "-ok", "probeMs=" + first.ms + " tarball=" + arm.reading, arm.reading)     process.exit(0)   }   const second = await probe(mirror + "/@deepseek-ai%2fdsh")   if (second.ok) {     const arm = await tarballRead(mirror)     if (!arm.ok) {       settle(mirror, "mirror-tarball-blackholed", "officialProbe=" + first.status + " mirrorMs=" + second.ms + " tarball=" + arm.reading, arm.reading + " (the FALLBACK mirror answered METADATA and not its TARBALL, so the probe FAILS here instead of stalling later)")       process.exit(1)     }     settle(mirror, "mirror-fallback", "officialProbe=" + first.status + " officialProbeMs=" + first.ms + " mirrorMs=" + second.ms + " tarball=" + arm.reading, arm.reading)     process.exit(0)   }   settle(registry, "both-unreachable", "officialProbe=" + first.status + " mirrorProbe=" + second.status, "not reached: no registry answered METADATA")  https://registry.npmjs.org https://registry.npmjs.org/@deepseek-ai%2fdsh https://registry.npmmirror.com official-registry /work/npm-registry.txt /@deepseek-ai/dsh/-/dsh-0.2.1-rc.3.tgz  
