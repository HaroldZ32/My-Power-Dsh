        "").replace(/^file:\/\//, "")).replace(/\/+$/, "") : "") +
        "/node_modules/@mpd-dsh/mpd/packages/mpd-mcp-gitbash/dist/launch.js")
      - git
    toolCallTimeoutMs: 60000
