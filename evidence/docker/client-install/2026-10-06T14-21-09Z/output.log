    forkProvider: fork
- id: mpd-ui-agent-team
  name: '@deepseek-ai/dsh-experimental-client-ui-agent-team'
- id: mcp-context7
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: context7
    transport: streamable-http
