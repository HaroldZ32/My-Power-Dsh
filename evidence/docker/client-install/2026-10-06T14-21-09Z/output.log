    (seen.said !== true) { seen.said = true; logGuard('[mpd-agent-team] DISABLED
    in a dsh-tui composition: the official team plugin registers its session
    projection through a ROOT-bound sessionProjections proxy, and the dsh-tui
    host refuses root.effect from a plugin activation - mpd-agent-team and
    mpd-tool-agent-team stay unmounted. THE MPD TEAM IS UNAFFECTED: since the
    team-plane split (W2) it runs on the NATIVE executor over ctx.subagents,
    which needs nothing from this row (see cordis.patch.yml TUI PLANE / W5)') }
    } catch (e) {} return true } catch (e) { try { logGuard('[mpd-agent-team]
    TUI-plane guard threw (' + String(e && e.message ? e.message : e) + ') - the
    row stays ENABLED; re-check the guard in cordis.patch.yml') } catch (e2) {}
    return false } })()
  config:
    maxMembers: 16
    maxTasks: 256
    maxPendingMessagesPerMember: 64
    maxMessageBytes: 32768
    disposalTimeoutMs: 5000
- id: mpd-roster-provider
  name: '@mpd-dsh/mpd/packages/mpd-roster-provider-plugin/dist/index.js'
  config:
    baseProvider: spawn
- id: mpd-tool-agent-team
  name: '@deepseek-ai/dsh-experimental-tool-agent-team'
  disabled: !!js >-
    (() => { const logGuard = (text) => { try { const gfs =
