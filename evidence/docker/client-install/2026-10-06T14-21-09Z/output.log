    } catch (e) {} const roots = [process.env.MPD_MCP_LOG_DIR,
    process.env.DSH_WORKSPACE_ROOT, cwd, gos.tmpdir()]; for (const root of
    roots) { if (typeof root !== 'string' || root.trim() === '') { continue }
    try { const dir = gpath.join(root, '.mpd', 'logs'); gfs.mkdirSync(dir, {
    recursive: true }); gfs.appendFileSync(gpath.join(dir,
    'mpd-patch-guards.log'), text + String.fromCharCode(10)); return } catch (e)
    {} } } catch (e) {} }; try { const hit = [...ctx.loader.entries()].some((e)
    => { const o = e && e.options; if (!o) return false; const n = typeof o.name
    === 'string' ? o.name : ''; const i = typeof o.id === 'string' ? o.id : '';
    return n.indexOf('@deepseek-harness-tui/dsh-tui') === 0 ||
    i.indexOf('dsh-tui') === 0 }); if (!hit) return false; try { const seen =
    globalThis.__mpdTuiPlaneGuard || (globalThis.__mpdTuiPlaneGuard = {}); if
    (seen.said !== true) { seen.said = true; logGuard('[mpd-agent-team] DISABLED
    in a dsh-tui composition: the official team plugin registers its session
