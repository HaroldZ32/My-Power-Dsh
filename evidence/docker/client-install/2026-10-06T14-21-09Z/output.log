    host refuses root.effect from a plugin activation - mpd-agent-team and
    mpd-tool-agent-team stay unmounted (see cordis.patch.yml TUI PLANE)') } }
    catch (e) {} return true } catch (e) { try { logGuard('[mpd-agent-team]
    TUI-plane guard threw (' + String(e && e.message ? e.message : e) + ') - the
    row stays ENABLED; re-check the guard in cordis.patch.yml') } catch (e2) {}
    return false } })()
  config:
