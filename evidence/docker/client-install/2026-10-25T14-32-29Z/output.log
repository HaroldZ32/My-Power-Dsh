    (!hostDirs.some((dir) => fs.existsSync(dir))) { say('DISABLED',
    'dsh-better-sidebar is resolvable from neither the profile node_modules nor
    the bundle'); return true } const manifest = readJson(path.join(profileDir,
    'package.json')); const bundles = manifest && manifest.dsh &&
    manifest.dsh.profile && Array.isArray(manifest.dsh.profile.bundles) ?
    manifest.dsh.profile.bundles : []; if (bundles.indexOf('dsh-better-sidebar')
    >= 0) { say('DISABLED', 'dsh-better-sidebar is itself a declared bundle
