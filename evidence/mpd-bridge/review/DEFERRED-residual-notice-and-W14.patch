+ */
+function findNamespaceDescriptor(payload, ns) {
+  const seen = new Set()
+  const stack = [payload]
+  while (stack.length > 0) {
+    const node = stack.pop()
+    if (node === null || node === undefined || typeof node !== "object" || seen.has(node)) continue
+    seen.add(node)
+    if (Array.isArray(node)) {
