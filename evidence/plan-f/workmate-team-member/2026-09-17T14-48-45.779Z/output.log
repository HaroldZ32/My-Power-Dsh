rgs:\n      - /root/dshProj/my-power-dsh/packages/mpd-mcp-gitbash/dist/cli.js\n    toolCallTimeoutMs: 60000\n- id: mcp-lsp\n  name: '@deepseek-ai/dsh-mcp-client'\n  config:\n    serverName: lsp\n    transport: stdio\n    command: node\n    args:\n      - /root/dshProj/my-power-dsh/packages/mpd-mcp-lsp/dist/cli.js\n      - mcp\n    toolCallTimeoutMs: 60000\n- id: mcp-codegraph\n  name: '@deepseek-ai/dsh-mcp-client'\n  config:\n    serverName: codegraph\n    transport: stdio\n    command: node\n    args:\n      - /root/dshProj/my-power-dsh/packages/mpd-mcp-codegraph/dist/serve.js\n    env:\n      MPD_CODEGRAPH_BIN: /root/dshProj/my-power-dsh/.toolchain/node_modules/.bin/codegraph\n    toolCallTimeoutMs: 60000\n- id: mcp-context7\n  name: '@deepseek-ai/dsh-mcp-client'\n  config:\n    serverName: context7\n    transport: streamable-http\n    url: https://mcp.context7.com/mcp\n    toolCallTimeoutMs: 60000\n- id: mcp-grepapp\n  name: '@deepseek-ai/dsh-mcp-client'\n  config:\n    serverName: grep_app\n    transport: streamable-http\n    url: https://mcp.grep.app\n    toolCallTimeoutMs: 60000\n- id: mpd-codegraph\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-codegraph-plugin/dist/index.js\n  config:\n    autoInit: true\n    initTimeoutMs: 60000\n    binary: /root/dshProj/my-power-dsh/.toolchain/node_modules/.bin/codegraph\n- id: mpd-tools\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-tools-plugin/dist/index.js\n  config:\n    writeGuard: true\n    truncateMaxBytes: 8192\n- id: mpd-modelchain\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-modelchain-plugin/dist/index.js\n- id: mpd-ulw\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-ulw-plugin/dist/index.js\n  config:\n    maxRounds: 3\n- id: mpd-hashline\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-hashline-plugin/dist/index.js\n  config:\n    guardEditTools: true\n- id: mpd-boulder\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-boulder-plugin/dist/index.js\n- id: mpd-dsh-adapter\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-dsh-adapter-plugin/dist/index.js\n- id: mpd-config\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-config-plugin/dist/index.js\n- id: mpd-comment-checker\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-comment-checker-plugin/dist/index.js\n  config:\n    autoCheck: false\n- id: mpd-memory\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-memory-plugin/dist/index.js\n  config:\n    vcs: git\n- id: mpd-ext\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-ext-plugin/dist/index.js\n  config:\n    quiet: false\n- id: mpd-roles\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-roles-plugin/dist/index.js\n- id: mpd-workmate\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-workmate-plugin/dist/index.js\n- id: mpd-team-compact\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-team-compact-plugin/dist/index.js\n- id: mpd-team-watchdog\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-team-watchdog-plugin/dist/index.js\n  config:\n    stateDir: .mpd/team\n    warnSilenceMs: 90000\n    tickIntervalMs: 15000\n    warnStreakToEscalate: 3\n    actionOnEscalate: pause\n- id: mpd-bootstrap\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-bootstrap-plugin/dist/index.js\n- id: mpd-tui\n  name: file:///root/dshProj/my-power-dsh/packages/mpd-tui-plugin/dist/index.js\n- id: agent-teams\n  name: >-\n    file:///root/dshProj/my-power-dsh/packages/mpd-agent-teams-plugin/lib/index.js\n  config:\n    stateDir: .mpd/team\n    memberProvider: spawn\n    memberMaxDepth: 1\n    maxMembers: 16\n    maxParallelMembers: 8\n    maxMessagesPerRun: 10000\n    maxWallClockMinutes: 120\n    maxMemberTurns: 500\n    messagePayloadMaxBytes: 32768\n    recipientUnreadMaxBytes: 262144\n    mailboxPollIntervalMs: 3000\n    enforcement: enforce\n    reclaimStaleAfterMs: 3600000\n    sessionTeamPolicy:\n      mode: 'off'\n      autoRoute: true\n      profile: mpd\n      presets:\n        - mpd\n      name: MPD Default\n      approval: required\n    profiles:\n      mpd:\n        description: >-\n          The specialist roster surfaced as normal-named teammate templates —\n          captain-planned (roster only; the captain designs the DAG during the\n          staged plan).\n        protocol: >-\n          Read-only members (Architect, Researcher, Planner, Explorer, Plan\n          Reviewer, Vision Analyst) take requirements/review/analysis tasks only\n          and never edit files. Workers (Senior Engineer, Junior Engineer, Deep\n          Worker, Lead, Reviewer) take implementation/verification/integration.\n          The captain leads, designs the DAG, and integrates results. Workmate\n          reuse: before delegating a role task, consult mpd_workmate_list /\n          mpd_workmate_match(task); if a workmate note matches well, delegate to\n          that workmate (member name = workmate name, so its persona/memory are\n          injected), otherwise initialize a fresh workmate with\n          mpd_workmate_init — never force a weak note match.\n        taskPlanning: captain\n        members:\n          - name: Architect\n            reasoning_effort: max\n            role: architecture review / deep debugging / self-review\n            provider: deepseek-official\n            model: deepseek-v4-flash\n            fallback:\n              provider: deepseek-official\n              model: deepseek-v4-flash\n            executionPrompt: >-\n              Read-only architecture advisor. You advise, others execute — never\n              edit files. Favor simplicity and existing patterns; give one clear\n              recommendation with concise rationale and evidence.\n            toolDeny:\n              - write\n              - edit\n              - mpd_hashline_edit\n              - bash\n              - mcp__ast_grep__rewrite\n              - mcp__ast_grep__scan\n              - mcp__lsp__rename\n          - name: Researcher\n            role: code / open-source evidence search\n            provider: deepseek-official\n            model: deepseek-v4-flash\n            fallback:\n              provider: deepseek-official\n              model: deepseek-v4-flash\n            executionPrompt: >-\n              Read-only researcher. Gather evidence from the codebase, AST/LSP\n              and web sources; cite file:line and URLs; never edit files or\n              invent findings.\n            toolDeny:\n              - write\n              - edit\n              - mpd_hashline_edit\n              - bash\n              - mcp__ast_grep__rewrite\n              - mcp__ast_grep__scan\n              - mcp__lsp__rename\n          - name: Planner\n            reasoning_effort: max\n            role: planning / task decomposition\n            provider: deepseek-official\n            model: deepseek-v4-flash\n            fallback:\n              provider: deepseek-official\n              model: deepseek-v4-flash\n            executionPrompt: >-\n              Read-only planner. Produce decision-complete, step-ordered plans\n              with a checklist; never implement.\n            toolDeny:\n              - write\n              - edit\n              - mpd_hashline_edit\n              - bash\n              - mcp__ast_grep__rewrite\n              - mcp__ast_grep__scan\n              - mcp__lsp__rename\n          - name: Explorer\n            role: read-only codebase exploration\n            provider: deepseek-official\n            model: deepseek-v4-flash\n            fallback:\n              provider: deepseek-official\n              model: deepseek-v4-flash\n            executionPrompt: >-\n              Read-only exp