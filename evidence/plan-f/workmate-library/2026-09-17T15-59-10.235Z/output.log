  name: file:///root/dshProj/my-power-dsh/packages/mpd-tui-plugin/dist/index.js
- id: agent-teams
  name: >-
    file:///root/dshProj/my-power-dsh/packages/mpd-agent-teams-plugin/lib/index.js
  config:
    stateDir: .mpd/team
    memberProvider: spawn
    memberMaxDepth: 1
    maxMembers: 16
    maxParallelMembers: 8
    maxMessagesPerRun: 10000
    maxWallClockMinutes: 120
    maxMemberTurns: 500
    messagePayloadMaxBytes: 32768
    recipientUnreadMaxBytes: 262144
    mailboxPollIntervalMs: 3000
    enforcement: enforce
    reclaimStaleAfterMs: 3600000
    sessionTeamPolicy:
      mode: 'off'
      autoRoute: true
      profile: mpd
      presets:
        - mpd
      name: MPD Default
      approval: required
    profiles:
      mpd:
        description: >-
          The specialist roster surfaced as normal-named teammate templates —
          captain-planned (roster only; the captain designs the DAG during the
          staged plan).
        protocol: >-
          Read-only members (Architect, Researcher, Planner, Explorer, Plan
          Reviewer, Vision Analyst) take requirements/review/analysis tasks only
          and never edit files. Workers (Senior Engineer, Junior Engineer, Deep
          Worker, Lead, Reviewer) take implementation/verification/integration.
          The captain leads, designs the DAG, and integrates results. Workmate
          reuse: before delegating a role task, consult mpd_workmate_list /
          mpd_workmate_match(task); if a workmate note matches well, delegate to
          that workmate (member name = workmate name, so its persona/memory are
          injected), otherwise initialize a fresh workmate with
          mpd_workmate_init — never force a weak note match.
        taskPlanning: captain
        members:
          - name: Architect
            reasoning_effort: max
            role: architecture review / deep debugging / self-review
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only architecture advisor. You advise, others execute — never
              edit files. Favor simplicity and existing patterns; give one clear
              recommendation with concise rationale and evidence.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Researcher
            role: code / open-source evidence search
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only researcher. Gather evidence from the codebase, AST/LSP
              and web sources; cite file:line and URLs; never edit files or
              invent findings.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Planner
            reasoning_effort: max
            role: planning / task decomposition
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only planner. Produce decision-complete, step-ordered plans
              with a checklist; never implement.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Explorer
            role: read-only codebase exploration
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only explorer. Answer with evidence and absolute file paths;
              never edit files.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Reviewer
            reasoning_effort: max
            role: correctness / risk review
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Deep reviewer. Produce correctness/risk findings with evidence;
              recommend fixes but do not apply them.
          - name: Plan Reviewer
            role: work-plan QA review / UI-UX critique
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only plan reviewer. Verify plans are executable and
              references valid; reject only true blockers; UI/UX critique only
              when explicitly asked; never edit files.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Vision Analyst
            role: image / diagram analysis
            provider: deepseek-official
            model: deepseek-v4-flash-vision-exp
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only vision analyst. Describe screenshots/diagrams precisely;
              never edit files or load anything by path.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Lead
            reasoning_effort: max
            role: orchestration / integration
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Orchestrator. Plan the macro structure, delegate independent units
              in parallel, integrate and verify results.
          - name: Deep Worker
            role: autonomous goal-driven implementation
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Autonomous deep worker. Receive goals, execute them end-to-end
              with tools, verify every change, report evidence-first.
          - name: Senior Engineer
            reasoning_effort: max
            role: primary implementation
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Primary engineer. Plan small, execute with tools, keep diffs
              minimal, verify every change, report honestly.
          - name: Junior Engineer
            role: small mechanical changes
            provider: deepseek-official
            model: deepseek-v4-flash
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Fast executor. Small, well-scoped mechanical changes with quick
              verification; keep diffs tiny.
