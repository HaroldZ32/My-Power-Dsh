  const root = workmateRoot()   // $HOME/.mpd/workmate
  const home = process.env.HOME
  const realHome = homedir()    // cached process-start value
  const inside = (h) => root === h || root.startsWith(h + sep)
  if (home !== undefined && home !== "" && resolve(home) !== resolve(realHome) && inside(resolve(home))) return
  throw ...
}
