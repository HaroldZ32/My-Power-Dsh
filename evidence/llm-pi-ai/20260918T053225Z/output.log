- id: web-ui-better-sidebar
  name: dsh-better-sidebar
# == dshmarket
- id: dsh-market
  name: dshmarket
# == dsh-cost-meter
- id: cost-meter
  name: dsh-cost-meter
# == nowledge-mem-deepseek-harness
- id: nowledge-mem
  name: nowledge-mem-deepseek-harness
  config:
    sourceApp: deepseek-harness
    importOrigin: deepseek-harness
    contextOnSessionStart: true
    recallOnPrompt: true
    syncOnTurnEnd: true
- id: nowledge-mem-mcp
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: nowledge_mem
    transport: streamable-http
    url: !!js >-
      (process.env.NMEM_MCP_URL ?? process.env.NOWLEDGE_MEM_MCP_URL ??
      'http://127.0.0.1:14242/mcp').replace(/\/+$/, '')
    headers: !!js |
      Object.fromEntries(Object.entries({
        APP: 'DeepSeek Harness',
        'X-Nmem-Tool-Set': 'external-agent',
        'X-Nowledge-Tool-Schema-Profile': 'slim',
        Authorization: process.env.NMEM_API_KEY ? `Bearer ${process.env.NMEM_API_KEY}` : undefined,
        'X-NMEM-API-Key': process.env.NMEM_API_KEY,
        'X-NMEM-Agent-ID': process.env.NMEM_AGENT_ID,
        'X-NMEM-Host-Agent-ID': process.env.NMEM_HOST_AGENT_ID,
      }).filter(([, value]) => typeof value === 'string' && value.length > 0))
    failOnStartupError: false
    toolCallTimeoutMs: 60000
# == @mpd-dsh/mpd
- id: mcp-astgrep
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: ast_grep
    transport: stdio
    command: node
    args:
      - !!js >-
        process.env.MPD_DSH_ASTGREP_CLI || ((typeof baseUrl === "string" ?
        baseUrl.replace(/^file:\/\//, "").replace(/\/+$/, "") : "") +
        "/node_modules/@mpd-dsh/mpd/packages/mpd-mcp-astgrep/launch.mjs")
    toolCallTimeoutMs: 60000
- id: mcp-gitbash
  name: '@deepseek-ai/dsh-mcp-client'
  disabled: true
  config:
    serverName: git_bash
    transport: stdio
    command: node
    args:
      - !!js >-
        process.env.MPD_DSH_GITBASH_CLI || ((typeof baseUrl === "string" ?
        baseUrl.replace(/^file:\/\//, "").replace(/\/+$/, "") : "") +
        "/node_modules/@mpd-dsh/mpd/packages/mpd-mcp-gitbash/dist/cli.js")
    toolCallTimeoutMs: 60000
- id: mcp-lsp
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: lsp
    transport: stdio
    command: node
    args:
      - !!js >-
        process.env.MPD_DSH_LSP_CLI || ((typeof baseUrl === "string" ?
        baseUrl.replace(/^file:\/\//, "").replace(/\/+$/, "") : "") +
        "/node_modules/@mpd-dsh/mpd/packages/mpd-mcp-lsp/dist/cli.js")
      - mcp
    toolCallTimeoutMs: 60000
- id: mcp-codegraph
  name: '@deepseek-ai/dsh-mcp-client'
  config:
    serverName: codegraph
    transport: stdio
    command: node
    args:
      - !!js >-
        process.env.MPD_DSH_CODEGRAPH_CLI || ((typeof baseUrl === "string" ?
        baseUrl.replace(/^file:\/\//, "").replace(/\/+$/, "") : "") +
        "/node_modules/@mpd-dsh/mpd/packages/mpd-mcp-codegraph/launch.mjs")
    toolCallTimeoutMs: 60000
- id: mpd-web-compat
  name: '@mpd-dsh/mpd'
- id: mpd-dsh-adapter
  name: '@mpd-dsh/mpd/packages/mpd-dsh-adapter-plugin/dist/index.js'
- id: mpd-config
  name: '@mpd-dsh/mpd/packages/mpd-config-plugin/dist/index.js'
- id: mpd-team-watchdog
  name: '@mpd-dsh/mpd/packages/mpd-team-watchdog-plugin/dist/index.js'
  config:
    stateDir: .mpd/team
    warnSilenceMs: 600000
    tickIntervalMs: 15000
    warnStreakToEscalate: 6
    actionOnEscalate: warn-only
    toolInFlightMaxMs: 900000
    holdTtlMs: 900000
- id: mpd-tools
  name: '@mpd-dsh/mpd/packages/mpd-tools-plugin/dist/index.js'
  config:
    writeGuard: true
    truncateMaxBytes: 8192
- id: mpd-modelchain
  name: '@mpd-dsh/mpd/packages/mpd-modelchain-plugin/dist/index.js'
- id: mpd-ext
  name: '@mpd-dsh/mpd/packages/mpd-ext-plugin/dist/index.js'
  config:
    quiet: false
- id: mpd-roles
  name: '@mpd-dsh/mpd/packages/mpd-roles-plugin/dist/index.js'
- id: mpd-ulw
  name: '@mpd-dsh/mpd/packages/mpd-ulw-plugin/dist/index.js'
  config:
    maxRounds: 3
- id: mpd-hashline
  name: '@mpd-dsh/mpd/packages/mpd-hashline-plugin/dist/index.js'
  config:
    guardEditTools: true
- id: mpd-boulder
  name: '@mpd-dsh/mpd/packages/mpd-boulder-plugin/dist/index.js'
- id: mpd-comment-checker
  name: '@mpd-dsh/mpd/packages/mpd-comment-checker-plugin/dist/index.js'
  config:
    autoCheck: false
- id: mpd-codegraph
  name: '@mpd-dsh/mpd/packages/mpd-codegraph-plugin/dist/index.js'
  config:
    autoInit: true
    initTimeoutMs: 60000
- id: mpd-memory
  name: '@mpd-dsh/mpd/packages/mpd-memory-plugin/dist/index.js'
  config:
    vcs: git
- id: mpd-workmate
  name: '@mpd-dsh/mpd/packages/mpd-workmate-plugin/dist/index.js'
- id: mpd-team-compact
  name: '@mpd-dsh/mpd/packages/mpd-team-compact-plugin/dist/index.js'
- id: mpd-bootstrap
  name: '@mpd-dsh/mpd/packages/mpd-bootstrap-plugin/dist/index.js'
- id: mpd-tui
  name: '@mpd-dsh/mpd/packages/mpd-tui-plugin/dist/index.js'
- id: agent-teams
  name: '@mpd-dsh/mpd/packages/mpd-agent-teams-plugin/lib/index.js'
  config:
    stateDir: .mpd/team
    memberProvider: spawn
    memberMaxDepth: 1
    maxMembers: 16
    maxParallelMembers: 8
    maxMessagesPerRun: 10000
    maxWallClockMinutes: 120
    maxMemberTurns: 500
    messagePayloadMaxBytes: 32768
    recipientUnreadMaxBytes: 262144
    mailboxPollIntervalMs: 3000
    enforcement: enforce
    reclaimStaleAfterMs: 3600000
    sessionTeamPolicy:
      mode: 'off'
      autoRoute: true
      profile: mpd
      presets:
        - mpd
      name: MPD Default
      approval: required
    profiles:
      mpd:
        description: >-
          The specialist roster surfaced as normal-named teammate templates —
          captain-planned (roster only; the captain designs the DAG during the
          staged plan).
        protocol: >-
          Read-only members (Architect, Researcher, Planner, Explorer, Plan
          Reviewer, Vision Analyst) take requirements/review/analysis tasks only
          and never edit files. Workers (Senior Engineer, Junior Engineer, Deep
          Worker, Lead, Reviewer) take implementation/verification/integration.
          The captain leads, designs the DAG, and integrates results. Workmate
          reuse: before delegating a role task, consult mpd_workmate_list /
          mpd_workmate_match(task); if a workmate note matches well, delegate to
          that workmate (member name = workmate name, so its persona/memory are
          injected), otherwise initialize a fresh workmate with
          mpd_workmate_init — never force a weak note match.
        taskPlanning: captain
        members:
          - name: Architect
            tier: 1
            role: architecture review / deep debugging / self-review
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only architecture advisor. You advise, others execute — never
              edit files. Favor simplicity and existing patterns; give one clear
              recommendation with concise rationale and evidence.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Researcher
            tier: 2
            role: code / open-source evidence search
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only researcher. Gather evidence from the codebase, AST/LSP
              and web sources; cite file:line and URLs; never edit files or
              invent findings.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Planner
            tier: 1
            role: planning / task decomposition
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only planner. Produce decision-complete, step-ordered plans
              with a checklist; never implement.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Explorer
            tier: 2
            role: read-only codebase exploration
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only explorer. Answer with evidence and absolute file paths;
              never edit files.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Reviewer
            tier: 1
            role: correctness / risk review
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Deep reviewer. Produce correctness/risk findings with evidence;
              recommend fixes but do not apply them.
          - name: Plan Reviewer
            tier: 2
            role: work-plan QA review / UI-UX critique
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only plan reviewer. Verify plans are executable and
              references valid; reject only true blockers; UI/UX critique only
              when explicitly asked; never edit files.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Vision Analyst
            route:
              provider: deepseek-official
              model: deepseek-v4-flash-vision-exp
              reasoningEffort: high
            role: image / diagram analysis
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Read-only vision analyst. Describe screenshots/diagrams precisely;
              never edit files or load anything by path.
            toolDeny:
              - write
              - edit
              - mpd_hashline_edit
              - bash
              - mcp__ast_grep__rewrite
              - mcp__ast_grep__scan
              - mcp__lsp__rename
          - name: Lead
            tier: 1
            role: orchestration / integration
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Orchestrator. Plan the macro structure, delegate independent units
              in parallel, integrate and verify results.
          - name: Deep Worker
            tier: 3
            role: autonomous goal-driven implementation
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Autonomous deep worker. Receive goals, execute them end-to-end
              with tools, verify every change, report evidence-first.
          - name: Senior Engineer
            tier: 1
            role: primary implementation
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Primary engineer. Plan small, execute with tools, keep diffs
              minimal, verify every change, report honestly.
          - name: Junior Engineer
            tier: 3
            role: small mechanical changes
            fallback:
              provider: deepseek-official
              model: deepseek-v4-flash
            executionPrompt: >-
              Fast executor. Small, well-scoped mechanical changes with quick
              verification; keep diffs tiny.
- id: mcp-context7
