{
  "name": "my-power-dsh",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "my-power-dsh: DeepSeek Harness plugin-based port of oh-my-openagent capabilities",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test",
    "test:fast": "bun test --test-timeout 30000",
    "test:qa": "bun run skills/dsh-qa/scripts/mount-assert.mjs --self-test",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "evidence:mount": "node skills/dsh-qa/scripts/mount-assert.mjs --expect \"name: '@deepseek-ai/dsh-llm'\""
  },
  "workspaces": [
    "packages/*"
  ]
}
