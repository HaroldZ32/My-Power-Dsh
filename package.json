{
  "name": "@mpd-dsh/mpd",
  "private": false,
  "type": "module",
  "buildToolchain": "bun@1.4.0",
  "version": "0.17.5",
  "description": "A DeepSeek Harness plugin bundle: an eleven-role specialist roster, a durable workmate library, team staging with a shared board, and native dsh-Go panels and tool cards.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin-bundle",
    "agent-teams",
    "roster",
    "workmate",
    "memory",
    "tui",
    "dsh-go",
    "native-ui"
  ],
  "main": "packages/mpd-bundle-plugin/dist/index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaroldZ32/My-Power-Dsh.git"
  },
  "homepage": "https://github.com/HaroldZ32/My-Power-Dsh#readme",
  "bugs": {
    "url": "https://github.com/HaroldZ32/My-Power-Dsh/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "EXTENSIONS-FOR-AGENTS.md",
    "LICENSE-NOTICES.md",
    "LICENSE.md",
    "PLAN.md",
    "README.md",
    "README.zh-CN.md",
    "VENDOR_LOCK.json",
    "agent-references/**",
    "cordis.patch.yml",
    "docs/**",
    "dsh-distribution.json",
    "dsh-go",
    "dsh-plugin.json",
    "extensions/**",
    "icon.svg",
    "locale/*.json",
    "packages/**",
    "!packages/*/_deps/**",
    "presets/**",
    "scripts/**",
    "skills/**",
    "templates/**"
  ],
  "exports": {
    ".": "./packages/mpd-bundle-plugin/dist/index.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./packages/*": "./packages/*",
    "./skills/*": "./skills/*",
    "./presets/*": "./presets/*",
    "./extensions/*": "./extensions/*",
    "./client": "./packages/mpd-bundle-plugin/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/mpd.patch.yml"
      ]
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "dshGo": {
    "v": 1,
    "title": {
      "en": "MPD",
      "zh": "MPD"
    },
    "icon": "bolt",
    "wants": [
      "message"
    ],
    "contributes": {
      "panels": [
        {
          "id": "mpd",
          "title": {
            "en": "MPD Workbench",
            "zh": "MPD 工作台"
          },
          "icon": "bolt",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ],
          "view": "./dsh-go/views/mpd.json"
        },
        {
          "id": "mpd-team",
          "title": {
            "en": "MPD Team Board",
            "zh": "MPD 团队看板"
          },
          "icon": "team",
          "placement": [
            "session.tab",
            "features",
            "chat.panel"
          ],
          "view": "./dsh-go/views/mpd-team.json"
        }
      ],
      "composer.strip": [
        {
          "id": "mpd-status",
          "icon": "team",
          "panel": "mpd",
          "text": "—"
        }
      ],
      "composer.actions": [
        {
          "id": "mpd-dispatch",
          "label": {
            "en": "Dispatch",
            "zh": "派活"
          },
          "icon": "send"
        },
        {
          "id": "mpd-board",
          "label": {
            "en": "Board",
            "zh": "看板"
          },
          "icon": "panel",
          "effect": {
            "type": "open",
            "page": "panel:mpd-team"
          }
        }
      ],
      "message.actions": [
        {
          "id": "mpd-save-memory",
          "label": {
            "en": "Save memory",
            "zh": "存为记忆"
          },
          "icon": "save"
        },
        {
          "id": "mpd-copy-reply",
          "label": {
            "en": "Copy reply",
            "zh": "复制正文"
          },
          "icon": "copy"
        }
      ]
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test packages",
    "test:fast": "bun test packages --test-timeout 30000",
    "test:qa": "node scripts/run-qa-selftests.ts",
    "test:qa:strict": "node scripts/run-qa-selftests.ts --strict",
    "test:qa:all": "node scripts/run-qa-lanes.ts",
    "verify:vendor": "node scripts/verify-vendor.ts",
    "verify:rows": "node scripts/verify-rows-parity.ts",
    "verify:docs": "node scripts/verify-docs-parity.ts",
    "verify:dist": "node scripts/verify-dist-fresh.ts",
    "verify:manifest": "node scripts/verify-plugin-manifest.ts --pack",
    "verify:comments": "node scripts/verify-comment-coverage.ts",
  "verify:tui-admission": "node scripts/verify-tui-admission.ts",
    "verify:graph": "node scripts/verify-graph-model.ts",
    "verify:gates": "node ./scripts/verify-gates.ts",
    "repin:vendor": "node scripts/repin-vendor.ts",
    "dump-config": "node scripts/dump-config.ts",
    "bootstrap": "node scripts/bootstrap.ts",
    "evidence:mount": "node scripts/evidence-mount.ts",
    "pack": "node scripts/pack-mpd.ts",
    "verify:docker": "node ./scripts/docker-e2e.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "optionalDependencies": {
    "@colbymchenry/codegraph": "1.5.0",
    "cclsp": "0.7.0",
    "@cyanheads/git-mcp-server": "2.15.3",
    "mcp-server-commands": "0.8.2"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-types": "^1.4.0",
    "dsh-better-sidebar": "0.28.0",
    "typescript5": "npm:typescript@5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-agent-team": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.2.1-rc.5",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.2.1-rc.5",
    "@dsh-std/sdk": "0.1.1-rc.2"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.28.0 <0.29.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
