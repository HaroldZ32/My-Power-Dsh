{
  "name": "@mpd-dsh/mpd",
  "private": false,
  "type": "module",
  "buildToolchain": "bun@1.4.0",
  "version": "0.11.3",
  "description": "my-power-dsh: a DeepSeek Harness plugin bundle (@mpd-dsh/mpd) carrying the specialist roster and the model-chain vocabulary on DSH-native plumbing (upstream baseline: oh-my-openagent 8c57e46, pinned)",
  "main": "packages/mpd-bundle-plugin/dist/index.js",
  "icon": "./icon.svg",
  "license": "SEE LICENSE IN LICENSE.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HaroldZ32/My-Power-Dsh.git"
  },
  "homepage": "https://github.com/HaroldZ32/My-Power-Dsh#readme",
  "bugs": {
    "url": "https://github.com/HaroldZ32/My-Power-Dsh/issues"
  },
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "AGENTS.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh-CN.md",
    "EXTENSIONS-FOR-AGENTS.md",
    "LICENSE-NOTICES.md",
    "LICENSE.md",
    "PLAN.md",
    "README.md",
    "README.zh-CN.md",
    "SECURITY.md",
    "SECURITY.zh-CN.md",
    "VENDOR_LOCK.json",
    "agent-references/**",
    "docs/**",
    "dsh-distribution.json",
    "dsh-plugin.json",
    "extensions/**",
    "icon.svg",
    "locale/*.json",
    "packages/**",
    "!packages/*/_deps/**",
    "presets/**",
    "scripts/**",
    "skills/**",
    "templates/**"
  ],
  "exports": {
    ".": "./packages/mpd-bundle-plugin/dist/index.js",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./packages/*": "./packages/*",
    "./skills/*": "./skills/*",
    "./presets/*": "./presets/*",
    "./extensions/*": "./extensions/*",
    "./client": "./packages/mpd-bundle-plugin/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./packages/mpd-bundle/cordis.patch.yml",
        "./presets/mpd.patch.yml"
      ]
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test packages",
    "test:fast": "bun test packages --test-timeout 30000",
    "test:qa": "node scripts/run-qa-selftests.ts",
    "test:qa:strict": "node scripts/run-qa-selftests.ts --strict",
    "test:qa:all": "node scripts/run-qa-lanes.ts",
    "verify:vendor": "node scripts/verify-vendor.ts",
    "verify:rows": "node scripts/verify-rows-parity.ts",
    "verify:docs": "node scripts/verify-docs-parity.ts",
    "verify:dist": "node scripts/verify-dist-fresh.ts",
    "verify:manifest": "node scripts/verify-plugin-manifest.ts",
    "verify:comments": "node scripts/verify-comment-coverage.ts",
    "verify:gates": "node ./scripts/verify-gates.ts",
    "repin:vendor": "node scripts/repin-vendor.ts",
    "dump-config": "node scripts/dump-config.ts",
    "bootstrap": "node scripts/bootstrap.ts",
    "evidence:mount": "node skills/dsh-qa/scripts/mount-assert.ts --expect \"name: '@deepseek-ai/dsh-llm'\"",
    "pack": "node scripts/pack-mpd.ts",
    "verify:docker": "node ./scripts/docker-e2e.ts"
  },
  "workspaces": [
    "packages/*"
  ],
  "optionalDependencies": {
    "@colbymchenry/codegraph": "1.5.0"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-types": "^1.4.0",
    "dsh-better-sidebar": "0.19.0-alpha.1",
    "typescript5": "npm:typescript@5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.1.7-rc.2"
  },
  "peerDependencies": {
    "dsh-better-sidebar": ">=0.19.0-alpha.1 <0.20.0"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
