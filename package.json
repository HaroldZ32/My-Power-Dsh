{
  "name": "@mpd-dsh/mpd",
  "private": true,
  "type": "module",
  "buildToolchain": "bun@1.4.0",
  "version": "0.10.0",
  "description": "my-power-dsh: a DeepSeek Harness plugin bundle (@mpd-dsh/mpd) carrying the specialist roster and the model-chain vocabulary on DSH-native plumbing (upstream baseline: oh-my-openagent 8c57e46, pinned)",
  "main": "packages/mpd-bundle-plugin/dist/index.js",
  "exports": {
    ".": "./packages/mpd-bundle-plugin/dist/index.js",
    "./package.json": "./package.json",
    "./packages/*": "./packages/*",
    "./skills/*": "./skills/*",
    "./presets/*": "./presets/*",
    "./extensions/*": "./extensions/*",
    "./client": "./packages/mpd-bundle-plugin/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./packages/mpd-bundle/cordis.patch.yml",
        "./presets/mpd.patch.yml"
      ]
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test packages",
    "test:fast": "bun test packages --test-timeout 30000",
    "test:qa": "node scripts/run-qa-selftests.mjs",
    "test:qa:strict": "node scripts/run-qa-selftests.mjs --strict",
    "test:qa:all": "node scripts/run-qa-lanes.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "verify:rows": "node scripts/verify-rows-parity.mjs",
    "verify:docs": "node scripts/verify-docs-parity.mjs",
    "verify:dist": "node scripts/verify-dist-fresh.mjs",
    "verify:gates": "node ./scripts/verify-gates.mjs",
    "repin:vendor": "node scripts/repin-vendor.mjs",
    "dump-config": "node scripts/dump-config.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "evidence:mount": "node skills/dsh-qa/scripts/mount-assert.mjs --expect \"name: '@deepseek-ai/dsh-llm'\"",
    "pack": "node scripts/pack-mpd.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "optionalDependencies": {
    "@ast-grep/cli": "0.45.2",
    "@colbymchenry/codegraph": "1.5.0",
    "@code-yeongyu/comment-checker": "0.8.0"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "bun-types": "^1.4.0"
  },
  "dependencies": {
    "dsh-better-sidebar": "0.19.0-alpha.1",
    "@deepseek-ai/dsh-experimental-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-client-ui-agent-team": "0.1.7-rc.2",
    "@deepseek-ai/dsh-experimental-tool-agent-team": "0.1.7-rc.2"
  }
}
