{
  "name": "my-power-dsh",
  "private": true,
  "type": "module",
  "version": "0.3.0",
  "description": "my-power-dsh: DeepSeek Harness plugin-based port of the upstream project capabilities",
  "scripts": {
    "typecheck": "tsgo --noEmit && node packages/mpd-agent-teams/node_modules/.bin/tsc --noEmit -p packages/mpd-agent-teams/tsconfig.json",
    "test": "bun test packages",
    "test:fast": "bun test packages --test-timeout 30000",
    "test:qa": "bun run skills/dsh-qa/scripts/mount-assert.mjs --self-test",
    "build:agent-teams": "node scripts/build-agent-teams.mjs",
    "test:agent-teams": "node packages/mpd-agent-teams/scripts/quality-gates-tdd.mjs && node packages/mpd-agent-teams/scripts/fallback-tdd.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "evidence:mount": "node skills/dsh-qa/scripts/mount-assert.mjs --expect \"name: '@deepseek-ai/dsh-llm'\""
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "bun-types": "1.4.0"
  }
}
